---
import BaseLayout from '../../layouts/BaseLayout.astro';

const REPO = 'DarkishLocket10/CullPix';
const repoUrl = `https://github.com/${REPO}`;
const releasesUrl = `${repoUrl}/releases/latest`;

/*
  Download links use GitHub's `/releases/latest/download/<asset>` redirect, which
  always 302s to the newest release's asset, so the buttons stay current even
  between site deploys, with no API call, no rate limit, and no JS required.

  The build-time fetch below is *only* for display metadata (version, date,
  sizes) and to read the real asset filenames, so the redirect URLs self-heal if
  the CI ever renames an artifact. It is wrapped in try/catch with sane fallbacks
  so a network blip during `astro build` can never break the page. A tiny client
  script (further down) refreshes the displayed version/sizes to absolute-latest.
*/
let version: string | null = null;
let publishedAt: string | null = null;
let macAsset = 'CullPix-macOS-arm64.dmg';
let winAsset = 'CullPix-Windows-x64.zip';
let macSize: number | null = null;
let winSize: number | null = null;

try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
    headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'yashnilay.ca' },
  });
  if (res.ok) {
    const data = await res.json();
    version = data.tag_name ?? null;
    publishedAt = data.published_at ?? null;
    const dmg = data.assets?.find((a: any) => a.name?.toLowerCase().endsWith('.dmg'));
    const zip = data.assets?.find((a: any) => a.name?.toLowerCase().endsWith('.zip'));
    if (dmg) { macAsset = dmg.name; macSize = dmg.size; }
    if (zip) { winAsset = zip.name; winSize = zip.size; }
  }
} catch {
  /* keep fallback defaults */
}

const macUrl = `${repoUrl}/releases/latest/download/${macAsset}`;
const winUrl = `${repoUrl}/releases/latest/download/${winAsset}`;

const fmtSize = (b: number | null) => (b ? `${Math.round(b / 1048576)} MB` : '');
const fmtDate = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const macSizeStr = fmtSize(macSize);
const winSizeStr = fmtSize(winSize);
const dateStr = fmtDate(publishedAt);

const features = [
  {
    title: 'Keyboard first',
    body: "Z keeps, X rejects, U undoes the last move. The arrow keys just step through photos when you only want to look. After a minute it's all muscle memory and your hand barely leaves the keyboard.",
    icon: 'keyboard',
  },
  {
    title: 'It loads ahead of you',
    body: "CullPix keeps a window of images cached around the one you're on, loaded on a background thread. So when you tap the arrow key, the next photo is already there. Loading off disk every single time is what the built-in OS viewer does, and that lag is the whole reason I made this.",
    icon: 'bolt',
  },
  {
    title: 'Works with RAW',
    body: "It decodes RAW files with LibRaw, so you can cull straight off the card before you ever open Lightroom. I throw 61 MP files from my Sony α7R V at it and it's smooth on my Surface Pro 11.",
    icon: 'aperture',
  },
  {
    title: 'Nothing gets deleted',
    body: "Keeps go into a 'keep' folder and rejects go into a 'discard' folder, both sitting right next to your originals. Hit U and the last file goes back exactly where it came from. You're never actually throwing anything away.",
    icon: 'folder',
  },
  {
    title: "The UI doesn't freeze",
    body: "Moving files and drawing thumbnails happen on background workers, so the app keeps responding while it works. My first version did the file moves on the main thread and stuttered for a moment on every keep. That bugged me enough to rewrite the whole thing.",
    icon: 'layers',
  },
  {
    title: 'Sorts files the way you do',
    body: "IMG_2 comes before IMG_10, not after it. Sounds obvious, but most file lists sort names as plain text and scramble your shots. CullPix reads the numbers as numbers, so you go through a shoot in the order you took it.",
    icon: 'sort',
  },
];

const shortcuts = [
  { keys: ['Z'], action: 'Keep the photo' },
  { keys: ['X'], action: 'Reject the photo' },
  { keys: ['U'], action: 'Undo the last move' },
  { keys: ['Ctrl', 'Z'], action: 'Undo the last move' },
  { keys: ['←', '→'], action: 'Step back / forward' },
  { keys: ['O'], action: 'Open a different folder' },
];

const formats = ['JPG', 'PNG', 'BMP', 'GIF', 'TIFF', 'WEBP', 'AVIF', 'RAW'];

const stats = [
  { big: 'RAW', small: 'supports many image types' },
  { big: '3 keys', small: 'keep, reject, undo' },
  { big: 'Native', small: 'Built with C++ & Qt 6.' },
  { big: 'Free', small: 'and open source' },
];
---

<BaseLayout
  title="CullPix | Fast photo culling for Mac and Windows"
  description="CullPix is a fast desktop app for culling photos. Keep, reject, or undo with one keystroke, with RAW support built in. Free download for macOS and Windows."
>
  <div class="cullpix">
    <section class="mx-auto max-w-6xl px-6 pt-6 pb-20">
      <!-- Back link -->
      <a href="/tools" class="cp-back" data-fade>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
        </svg>
        <span>Tools</span>
      </a>

      <!-- ─────────────────────────  HERO  ───────────────────────── -->
      <div class="cp-hero">
        <!-- Left: copy -->
        <div class="cp-hero-copy">
          <div class="cp-eyebrow" data-fade>
            <span class="cp-appicon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <defs>
                  <linearGradient id="cpIcon" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#7fe0ea" />
                    <stop offset="1" stop-color="#2C9AA8" />
                  </linearGradient>
                </defs>
                <rect x="2" y="2" width="44" height="44" rx="11" fill="url(#cpIcon)" />
                <rect x="13" y="11" width="18" height="14" rx="2.5" fill="#fff" opacity="0.55" />
                <rect x="17" y="16" width="18" height="14" rx="2.5" fill="#fff" />
                <path d="M21 23.2l3 3 6.5-6.8" stroke="#2C9AA8" stroke-width="2.4"
                      stroke-linecap="round" stroke-linejoin="round" fill="none" />
              </svg>
            </span>
            <span>Desktop app · macOS and Windows</span>
          </div>

          <h1 class="cp-title" data-fade>CullPix</h1>

          <p class="cp-tagline" data-fade>
            A fast app for culling photos. You open a folder, look at every shot at
            full size, and fire each one into the <strong>keep</strong> or
            <strong>reject</strong> subfolder with a single key. It's quick and straightforward.
          </p>

          <!-- Download buttons -->
          <div class="cp-cta" data-fade>
            <a id="dl-mac" class="cp-btn cp-btn-primary" href={macUrl} data-os="mac">
              <span class="cp-reco" hidden>Recommended for you</span>
              <span class="cp-btn-row">
                <svg class="cp-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M16.365 1.43c0 1.14-.42 2.2-1.12 2.98-.74.84-1.96 1.5-3.04 1.4-.13-1.1.4-2.27 1.07-3.01.74-.82 2.03-1.43 3.09-1.37zM20.79 17.2c-.55 1.27-.82 1.84-1.53 2.97-.99 1.57-2.39 3.53-4.12 3.55-1.54.02-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.03-3.05-1.79-4.04-3.36C-1.45 16.8-1.7 11.06.65 8.04 1.94 6.35 3.94 5.3 5.86 5.3c1.96 0 3.19 1.07 4.81 1.07 1.57 0 2.53-1.07 4.8-1.07 1.7 0 3.5.93 4.79 2.53-4.21 2.3-3.53 8.31.53 9.37z"/>
                </svg>
                <span class="cp-btn-text">
                  <span class="cp-btn-label">Download for macOS</span>
                  <span class="cp-btn-meta"><span id="mac-size">{macSizeStr}</span> · .dmg · Apple Silicon</span>
                </span>
              </span>
            </a>

            <a id="dl-win" class="cp-btn cp-btn-primary" href={winUrl} data-os="win">
              <span class="cp-reco" hidden>Recommended for you</span>
              <span class="cp-btn-row">
                <svg class="cp-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M3 5.6l7.5-1.03v7.24H3V5.6zm0 12.8l7.5 1.03v-7.15H3v6.12zM11.4 4.45L21 3.1v8.71h-9.6V4.45zm0 15.1L21 20.9v-8.62h-9.6v7.27z"/>
                </svg>
                <span class="cp-btn-text">
                  <span class="cp-btn-label">Download for Windows</span>
                  <span class="cp-btn-meta"><span id="win-size">{winSizeStr}</span> · .zip · 64-bit</span>
                </span>
              </span>
            </a>
          </div>

          <div class="cp-subcta" data-fade>
            <a class="cp-ghost" href={repoUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.21.7.83.58A12.01 12.01 0 0024 12.5C24 5.87 18.63.5 12 .5z"/>
              </svg>
              <span>View source on GitHub</span>
            </a>
            <span class="cp-rel">
              <span class="cp-rel-dot"></span>
              <span data-version>{version ?? 'Latest release'}</span>
              {dateStr && <span class="cp-rel-date"> · <span data-reldate>{dateStr}</span></span>}
            </span>
          </div>
        </div>

        <!-- Right: app window -->
        <figure class="cp-shot" data-fade>
          <div class="cp-glow" aria-hidden="true"></div>
          <div class="cp-window">
            <div class="cp-window-bar">
              <span class="cp-dot cp-dot-r"></span>
              <span class="cp-dot cp-dot-y"></span>
              <span class="cp-dot cp-dot-g"></span>
            </div>
            <img
              src="/postphotos/post 7 - cullpix/app.png"
              alt="CullPix in action, showing a full-resolution photo with keep, reject, and undo controls"
              loading="eager"
            />
          </div>
        </figure>
      </div>

      <!-- ─────────────────────────  STATS  ───────────────────────── -->
      <div class="cp-stats" data-fade>
        {stats.map((s) => (
          <div class="cp-stat">
            <span class="cp-stat-big">{s.big}</span>
            <span class="cp-stat-small">{s.small}</span>
          </div>
        ))}
      </div>

      <!-- ─────────────────────────  FEATURES  ───────────────────────── -->
      <h2 class="cp-h2" data-fade>What it does</h2>
      <p class="cp-lede" data-fade>
        The whole point is to triage any number of photos as fast as possible.
        Simple, familiar controls to keep or reject each image with hardly any lag.
        That's it.
      </p>

      <div class="cp-grid">
        {features.map((f) => (
          <div class="cp-card" data-fade>
            <span class="cp-card-icon" aria-hidden="true">
              {f.icon === 'keyboard' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2.5" y="6" width="19" height="12" rx="2" />
                  <path stroke-linecap="round" d="M6 9.5h.01M9 9.5h.01M12 9.5h.01M15 9.5h.01M18 9.5h.01M6 12.5h.01M9 12.5h.01M15 12.5h.01M18 12.5h.01M8.5 15.5h7" />
                </svg>
              )}
              {f.icon === 'bolt' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25-3 8.25h6.75L7.5 21.75l3-8.25H3.75z" />
                </svg>
              )}
              {f.icon === 'aperture' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="9" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v6m6.5 1.5l-5 3M21 12h-6m-1.5 6.5l-3-5M12 21v-6m-6.5-1.5l5-3M3 12h6m1.5-6.5l3 5" />
                </svg>
              )}
              {f.icon === 'folder' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75A1.5 1.5 0 015.25 5.25h3.4a1.5 1.5 0 011.06.44l1.1 1.1a1.5 1.5 0 001.06.44h6.13a1.5 1.5 0 011.5 1.5v8.58a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5V6.75z" />
                </svg>
              )}
              {f.icon === 'layers' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75l8.25 4.5L12 12.75 3.75 8.25 12 3.75zM4.5 12l7.5 4.09L19.5 12M4.5 15.75l7.5 4.09 7.5-4.09" />
                </svg>
              )}
              {f.icon === 'sort' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6h12m-12 6h8.25m-8.25 6h4.5M18 5.25v13.5m0 0l-2.75-2.75M18 18.75l2.75-2.75" />
                </svg>
              )}
            </span>
            <h3 class="cp-card-title">{f.title}</h3>
            <p class="cp-card-body">{f.body}</p>
          </div>
        ))}
      </div>

      <!-- ─────────────────────────  SHORTCUTS + CACHE  ───────────────────────── -->
      <div class="cp-split">
        <div class="cp-panel" data-fade>
          <h3 class="cp-panel-title">How you drive it</h3>
          <ul class="cp-keys">
            {shortcuts.map((s) => (
              <li>
                <span class="cp-key-combo">
                  {s.keys.map((k, i) => (
                    <>
                      {i > 0 && <span class="cp-key-plus">+</span>}
                      <kbd class="cp-kbd">{k}</kbd>
                    </>
                  ))}
                </span>
                <span class="cp-key-action">{s.action}</span>
              </li>
            ))}
          </ul>
        </div>

        <figure class="cp-panel cp-cache" data-fade>
          <img src="/postphotos/post 7 - cullpix/slide.gif" alt="Sliding-window cache animation" loading="lazy" />
          <figcaption>
            <h3 class="cp-panel-title">How the cache works</h3>
            <p>
              The photo you're on sits in the middle of a small ring of cached images.
              CullPix loads a few ahead and a few behind, then drops anything that
              falls outside that window so memory stays small. This is the part I spent
              the most time on, because it's the whole reason moving between photos
              feels instant.
            </p>
          </figcaption>
        </figure>
      </div>

      <!-- ─────────────────────────  FORMATS  ───────────────────────── -->
      <div class="cp-formats" data-fade>
        <span class="cp-formats-label">Supported file types:</span>
        <div class="cp-chips">
          {formats.map((f) => <span class="cp-chip">{f}</span>)}
        </div>
      </div>

      <!-- ─────────────────────────  STORY  ───────────────────────── -->
      <div class="cp-story" data-fade>
        <p>
          I built CullPix after a corrupted Piwigo database left me re-sorting hundreds
          of photos by hand in the OS viewer. I couldn't really find an app that worked the way I wanted,
           so I made my own. It started in Python, got way too slow, and
          ended up in C++. This idea began as a way for me to save a whole bunch of time while proving to myself
          that I could actually create something useful. What's cool is that I still use it all the time. My friend Josiah summed it up better
          than I could: “you had an idea, you brought it to life, and that's sick.”
        </p>
        <a class="cp-storylink" href="/posts/building-cullpix">
          Read how I built it
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- ─────────────────────────  DOWNLOAD CTA  ───────────────────────── -->
      <div class="cp-download glass3d no-rim" data-fade>
        <h2 class="cp-download-title">Get CullPix</h2>
        <p class="cp-download-sub">
          It's free and open source. You're grabbing the latest build,
          <span data-version>{version ?? 'the newest release'}</span>{dateStr && <>, from <span data-reldate>{dateStr}</span></>}.
        </p>

        <div class="cp-cta cp-cta-center">
          <a id="dl-mac-2" class="cp-btn cp-btn-primary" href={macUrl} data-os="mac">
            <span class="cp-reco" hidden>Recommended for you</span>
            <span class="cp-btn-row">
              <svg class="cp-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16.365 1.43c0 1.14-.42 2.2-1.12 2.98-.74.84-1.96 1.5-3.04 1.4-.13-1.1.4-2.27 1.07-3.01.74-.82 2.03-1.43 3.09-1.37zM20.79 17.2c-.55 1.27-.82 1.84-1.53 2.97-.99 1.57-2.39 3.53-4.12 3.55-1.54.02-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.03-3.05-1.79-4.04-3.36C-1.45 16.8-1.7 11.06.65 8.04 1.94 6.35 3.94 5.3 5.86 5.3c1.96 0 3.19 1.07 4.81 1.07 1.57 0 2.53-1.07 4.8-1.07 1.7 0 3.5.93 4.79 2.53-4.21 2.3-3.53 8.31.53 9.37z"/>
              </svg>
              <span class="cp-btn-text">
                <span class="cp-btn-label">macOS</span>
                <span class="cp-btn-meta"><span class="mac-size">{macSizeStr}</span> · .dmg</span>
              </span>
            </span>
          </a>
          <a id="dl-win-2" class="cp-btn cp-btn-primary" href={winUrl} data-os="win">
            <span class="cp-reco" hidden>Recommended for you</span>
            <span class="cp-btn-row">
              <svg class="cp-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3 5.6l7.5-1.03v7.24H3V5.6zm0 12.8l7.5 1.03v-7.15H3v6.12zM11.4 4.45L21 3.1v8.71h-9.6V4.45zm0 15.1L21 20.9v-8.62h-9.6v7.27z"/>
              </svg>
              <span class="cp-btn-text">
                <span class="cp-btn-label">Windows</span>
                <span class="cp-btn-meta"><span class="win-size">{winSizeStr}</span> · .zip</span>
              </span>
            </span>
          </a>
        </div>

        <div class="cp-reqs">
          <div class="cp-req">
            <strong>macOS</strong>
            <span>Apple Silicon (M1 or newer), macOS 12 or later.</span>
            <span class="cp-req-note">It isn't notarized yet, so the first time you run it, right-click the app and hit <em>Open</em>.</span>
          </div>
          <div class="cp-req">
            <strong>Windows</strong>
            <span>Windows 10 or 11, 64-bit. It's portable, so there's no installer.</span>
            <span class="cp-req-note">If SmartScreen pops up, click <em>More info</em>, then <em>Run anyway</em>.</span>
          </div>
        </div>

        <a class="cp-ghost cp-ghost-center" href={releasesUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.21.7.83.58A12.01 12.01 0 0024 12.5C24 5.87 18.63.5 12 .5z"/>
          </svg>
          <span>All releases and the source on GitHub</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* ════════════════  CullPix product page  ════════════════ */
  .cullpix {
    --cp-accent: var(--color-accent);
    --cp-accent-hover: var(--color-accent-hover);
    --cp-border: rgba(0, 0, 0, 0.10);
    --cp-border-soft: rgba(0, 0, 0, 0.07);
    --cp-surface: var(--card-bg);
  }
  .dark .cullpix {
    --cp-border: rgba(255, 255, 255, 0.12);
    --cp-border-soft: rgba(255, 255, 255, 0.07);
  }

  /* data-fade reveal, same idiom as the rest of the site */
  .cullpix [data-fade] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .cullpix [data-fade]:not(.opacity-0) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .cullpix [data-fade] { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* Back link */
  .cp-back {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin: 0.5rem 0 2.5rem;
    font-size: 0.9rem; font-weight: 600;
    color: var(--color-text-soft);
    transition: color 0.18s ease, gap 0.18s ease;
  }
  .cp-back svg { width: 1.05rem; height: 1.05rem; }
  .cp-back:hover { color: var(--cp-accent); gap: 0.65rem; }

