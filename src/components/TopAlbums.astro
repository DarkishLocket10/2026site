---
import topAlbumsData from '../data/top-albums.json';

type Album = {
  rank: number;
  name: string;
  artist: string;
  playcount: number;
  url: string;
  image: string | null;
  imageSource: string | null;
};

type TopAlbumsData = {
  user: string;
  period: string;
  updatedAt: string | null;
  albums: Album[];
};

const data = topAlbumsData as TopAlbumsData;
const albums = data.albums ?? [];
const hasData = albums.length > 0;

const updatedLabel = data.updatedAt
  ? new Date(data.updatedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const lastFmProfile = `https://www.last.fm/user/${data.user}`;
const initial = albums[0];
---

<section id="listening" class="w-full py-6 overflow-x-clip">
  <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 xl:px-12 2xl:px-16">
    <div
      class="
        mb-6
        opacity-0 translate-x-6
        transition-all duration-700 ease-out delay-0
        motion-reduce:opacity-100 motion-reduce:translate-x-0
      "
      data-fade
    >
      <h2 class="text-3xl md:text-4xl font-semibold">🎧 What I've been listening to</h2>
      {updatedLabel ? (
        <p class="mt-2 text-sm" style="color: var(--color-text-soft);">
          Top of the last year on
          <a
            href={lastFmProfile}
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:opacity-80"
          >Last.fm</a>
          · refreshed {updatedLabel}
        </p>
      ) : (
        <p class="mt-2 text-sm" style="color: var(--color-text-soft);">
          Fresh list every December 3rd · pulled from
          <a
            href={lastFmProfile}
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:opacity-80"
          >Last.fm</a>
        </p>
      )}
    </div>

    {hasData && initial && (
      <div
        class="
          cascade-wrap
          opacity-0 translate-y-6
          transition-all duration-700 ease-out delay-100
          motion-reduce:opacity-100 motion-reduce:translate-y-0
        "
        data-fade
      >
        <div
          class="vinyl-cascade"
          role="listbox"
          aria-label="Top albums 3D carousel"
          tabindex="0"
          style={`--count: ${albums.length}; --active: 0;`}
        >
          <button class="nav nav-prev" data-prev type="button" aria-label="Previous album">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>

          <div class="stage">
            <div class="floor" aria-hidden="true"></div>
            {albums.map((album, i) => (
              <a
                class="case"
                href={album.url}
                target="_blank"
                rel="noopener noreferrer"
                style={`--i: ${i};`}
                data-index={i}
                data-name={album.name}
                data-artist={album.artist}
                data-plays={album.playcount}
                data-url={album.url}
                role="option"
                aria-label={`#${album.rank} ${album.name} by ${album.artist}, ${album.playcount} plays. Open on Last.fm.`}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                {album.image ? (
                  <img class="cover" src={album.image} alt="" loading="lazy" />
                ) : (
                  <div class="cover cover-fallback" aria-hidden="true"></div>
                )}
                <div class="edge-shade" aria-hidden="true"></div>
                <div class="sheen" aria-hidden="true"></div>
                <div class="pill">
                  <span class="pill-title">{album.name}</span>
                  <span class="pill-artist">{album.artist}</span>
                </div>
                <span class="rank" aria-hidden="true">#{album.rank}</span>
              </a>
            ))}
          </div>

          <button class="nav nav-next" data-next type="button" aria-label="Next album">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>

        <div class="now-playing" aria-live="polite">
          <span class="tag">ON ROTATION</span>
          <h3 class="np-title" data-np-title>{initial.name}</h3>
          <p class="np-meta">
            <span data-np-artist>{initial.artist}</span>
            ·
            <span data-np-plays>{initial.playcount.toLocaleString()} {initial.playcount === 1 ? 'play' : 'plays'}</span>
          </p>
          <a
            class="listen"
            data-listen
            href={initial.url}
            target="_blank"
            rel="noopener noreferrer"
          >Listen on Last.fm →</a>
        </div>

        <div class="dots" role="tablist" aria-label="Jump to album">
          {albums.map((_, i) => (
            <button
              class="dot"
              type="button"
              role="tab"
              data-dot={i}
              data-active={i === 0 ? 'true' : 'false'}
              aria-label={`Jump to album ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .cascade-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0 1rem;
  }

  .vinyl-cascade {
    position: relative;
    width: 100%;
    max-width: 1100px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
    outline: none;
  }

  /* === Nav buttons === */
  .nav {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--card-bg);
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    cursor: pointer;
    color: inherit;
    transition: all 160ms ease;
    z-index: 200;
  }
  .nav:hover,
  .nav:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 14%, var(--card-bg));
    border-color: var(--color-accent);
    outline: none;
  }
  .nav:active { transform: scale(0.94); }

  /* === Stage: 3D space the cards live in === */
  .stage {
    position: relative;
    height: 340px;
    perspective: 1500px;
    perspective-origin: 50% 46%;
    transform-style: preserve-3d;
    overflow: hidden;
    border-radius: 16px;
  }

  /* Soft floor reflection / vignette under the carousel */
  .floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    background:
      radial-gradient(ellipse 55% 100% at 50% 0%,
        color-mix(in srgb, var(--color-accent) 10%, transparent) 0%,
        transparent 70%),
      linear-gradient(to top,
        color-mix(in srgb, var(--color-accent) 6%, transparent),
        transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* === The vinyl case === */
  .case {
    --offset: calc(var(--i) - var(--active));
    --abs: max(var(--offset), calc(var(--offset) * -1));

    position: absolute;
    left: 50%;
    top: 50%;
    width: 220px;
    height: 220px;
    margin: -110px 0 0 -110px;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    outline: none;
    text-decoration: none;
    color: inherit;
    background: #0e0e0e;

    transform-style: preserve-3d;
    transform:
      translateX(clamp(-500px, calc(var(--offset) * 150px), 500px))
      translateZ(clamp(-320px, calc(var(--abs) * -95px), 0px))
      rotateY(clamp(-62deg, calc(var(--offset) * -48deg), 62deg));

    transition:
      transform 540ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 380ms ease,
      opacity 380ms ease,
      box-shadow 360ms ease;

    opacity: clamp(0, calc(1 - var(--abs) * 0.14), 1);
    z-index: calc(100 - var(--abs));
    filter: brightness(0.72) saturate(0.82);

    box-shadow:
      0 22px 42px -16px rgba(0, 0, 0, 0.65),
      0 6px 14px -4px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .case[aria-selected="true"] {
    filter: brightness(1) saturate(1);
    box-shadow:
      0 32px 54px -14px rgba(0, 0, 0, 0.72),
      0 14px 28px -8px color-mix(in srgb, var(--color-accent) 45%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-accent) 32%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .case:hover {
    filter: brightness(0.92) saturate(0.95);
  }
  .case[aria-selected="true"]:hover {
    filter: brightness(1.05) saturate(1);
  }

  .case:focus-visible {
    box-shadow:
      0 22px 42px -16px rgba(0, 0, 0, 0.65),
      0 0 0 3px var(--color-accent);
  }

  .case .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    display: block;
  }

  .case .cover-fallback {
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--color-accent) 55%, #333) 0%,
      #0a0a0a 100%);
  }

  /* Vinyl-case edge shading: subtle spine darkening on the sides that are
     turning away from the viewer. */
  .case .edge-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow:
      inset 3px 0 4px -1px rgba(0, 0, 0, 0.5),
      inset -3px 0 4px -1px rgba(0, 0, 0, 0.35),
      inset 0 2px 2px rgba(255, 255, 255, 0.08),
      inset 0 -2px 3px rgba(0, 0, 0, 0.3);
  }

  .case .sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(135deg,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.0) 30%,
      rgba(0, 0, 0, 0.0) 65%,
      rgba(0, 0, 0, 0.28) 100%);
  }

  .case .pill {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #0e0e0e;
    font-size: 11px;
    line-height: 1.2;
    max-width: calc(100% - 24px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.22);
    pointer-events: none;
    opacity: clamp(0, calc(1 - var(--abs) * 0.4), 1);
    transition: opacity 380ms ease;
  }
  .case .pill-title { font-weight: 800; }
  .case .pill-artist { font-weight: 500; opacity: 0.72; }

  .case .rank {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 2px 7px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 999px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    pointer-events: none;
    opacity: clamp(0, calc(1 - var(--abs) * 0.5), 1);
    transition: opacity 380ms ease;
  }

  @media (max-width: 900px) {
    .stage { height: 290px; }
    .case {
      width: 180px;
      height: 180px;
      margin: -90px 0 0 -90px;
      transform:
        translateX(clamp(-360px, calc(var(--offset) * 120px), 360px))
        translateZ(clamp(-280px, calc(var(--abs) * -80px), 0px))
        rotateY(clamp(-60deg, calc(var(--offset) * -46deg), 60deg));
    }
  }

  @media (max-width: 560px) {
    .stage { height: 240px; }
    .case {
      width: 140px;
      height: 140px;
      margin: -70px 0 0 -70px;
      transform:
        translateX(clamp(-260px, calc(var(--offset) * 90px), 260px))
        translateZ(clamp(-220px, calc(var(--abs) * -68px), 0px))
        rotateY(clamp(-58deg, calc(var(--offset) * -44deg), 58deg));
    }
    .nav { width: 36px; height: 36px; }
  }

  /* === Now playing === */
  .now-playing {
    text-align: center;
    min-height: 110px;
    width: 100%;
    max-width: 560px;
  }

  .now-playing .tag {
    display: inline-block;
    padding: 3px 12px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.24em;
    background: var(--color-accent);
    color: #fff;
    border-radius: 999px;
    margin-bottom: 10px;
  }

  .np-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
    transition: opacity 220ms ease;
  }

  .np-meta {
    font-size: 13px;
    opacity: 0.82;
    margin: 4px 0 10px;
    transition: opacity 220ms ease;
  }

  .listen {
    display: inline-block;
    padding: 7px 18px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 160ms ease;
  }
  .listen:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 6px 14px -6px color-mix(in srgb, var(--color-accent) 60%, transparent);
  }

  /* === Dots === */
  .dots {
    display: flex;
    gap: 7px;
    margin-top: 0.25rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 25%, transparent);
    cursor: pointer;
    transition: all 220ms ease;
  }
  .dot:hover { background: color-mix(in srgb, var(--color-accent) 70%, transparent); }
  .dot[data-active="true"] {
    width: 22px;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .case { transition: opacity 200ms ease, filter 200ms ease; }
  }
</style>

<script is:inline>
  (function () {
    const carousel = document.querySelector('.vinyl-cascade');
    if (!carousel) return;
    const cases = Array.from(carousel.querySelectorAll('.case'));
    if (!cases.length) return;

    const prevBtn = carousel.querySelector('[data-prev]');
    const nextBtn = carousel.querySelector('[data-next]');
    const dots = Array.from(document.querySelectorAll('[data-dot]'));
    const titleEl = document.querySelector('[data-np-title]');
    const artistEl = document.querySelector('[data-np-artist]');
    const playsEl = document.querySelector('[data-np-plays]');
    const listenEl = document.querySelector('[data-listen]');

    let active = 0;
    let fadeTimer = null;

    function setActive(i, viaClick) {
      const n = cases.length;
      i = ((i % n) + n) % n;
      if (i === active && !viaClick) return;
      active = i;
      carousel.style.setProperty('--active', String(i));

      cases.forEach((el, idx) => {
        el.setAttribute('aria-selected', idx === i ? 'true' : 'false');
      });
      dots.forEach((el, idx) => {
        const on = idx === i;
        el.dataset.active = on ? 'true' : 'false';
        el.setAttribute('aria-selected', on ? 'true' : 'false');
      });

      const c = cases[i];
      const { name, artist, plays, url } = c.dataset;

      if (titleEl || artistEl || playsEl) {
        // Micro-fade the readout so updates feel smooth
        [titleEl, artistEl, playsEl].forEach((el) => el && (el.style.opacity = '0.35'));
        if (fadeTimer) clearTimeout(fadeTimer);
        fadeTimer = setTimeout(() => {
          if (titleEl) titleEl.textContent = name || '';
          if (artistEl) artistEl.textContent = artist || '';
          if (playsEl) {
            const num = Number(plays || 0);
            playsEl.textContent = `${num.toLocaleString()} ${num === 1 ? 'play' : 'plays'}`;
          }
          [titleEl, artistEl, playsEl].forEach((el) => el && (el.style.opacity = ''));
        }, 120);
      }
      if (listenEl && url) listenEl.href = url;
    }

    // Click on card: if not active, bring to center; if active, follow link.
    cases.forEach((el, i) => {
      el.addEventListener('click', (e) => {
        if (i !== active) {
          e.preventDefault();
          setActive(i, true);
          el.focus({ preventScroll: true });
        }
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', () => setActive(active - 1, true));
    if (nextBtn) nextBtn.addEventListener('click', () => setActive(active + 1, true));

    dots.forEach((el, i) => {
      el.addEventListener('click', () => setActive(i, true));
    });

    // Keyboard navigation — works when focus is anywhere inside the carousel.
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); setActive(active - 1, true); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); setActive(active + 1, true); }
      else if (e.key === 'Home') { e.preventDefault(); setActive(0, true); }
      else if (e.key === 'End') { e.preventDefault(); setActive(cases.length - 1, true); }
    });

    // Touch swipe
    let tStartX = 0, tStartY = 0, tActive = false;
    carousel.addEventListener('touchstart', (e) => {
      tStartX = e.touches[0].clientX;
      tStartY = e.touches[0].clientY;
      tActive = true;
    }, { passive: true });
    carousel.addEventListener('touchend', (e) => {
      if (!tActive) return;
      tActive = false;
      const dx = e.changedTouches[0].clientX - tStartX;
      const dy = e.changedTouches[0].clientY - tStartY;
      if (Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy)) {
        setActive(dx > 0 ? active - 1 : active + 1, true);
      }
    });

    // Horizontal mouse wheel / shift-wheel
    let wheelLock = 0;
    carousel.addEventListener('wheel', (e) => {
      const now = Date.now();
      if (now - wheelLock < 320) return;
      const horizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY);
      if (!horizontal && !e.shiftKey) return;
      const delta = horizontal ? e.deltaX : e.deltaY;
      if (Math.abs(delta) < 12) return;
      e.preventDefault();
      setActive(active + (delta > 0 ? 1 : -1), true);
      wheelLock = now;
    }, { passive: false });
  })();
</script>
