---
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/#hero",                   label: "Home" },
  { href: "/#professional-experience", label: "Hire me" },
  { href: "/#photography",             label: "Photography" },
  { href: "/blog",                     label: "Blog" }
];
---
<header
  class="
    sticky top-0 z-30
    backdrop-blur-md
    text-[color:var(--text)]
  "
  style="height: 4.5rem;"
>
  <nav class="mx-auto max-w-7xl flex items-center justify-between px-6 py-4">
    <!-- Brand -->
    <a
      href="/"
      class="text-lg font-bold tracking-tight relative
             after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5
             after:origin-left after:scale-x-0 after:bg-current
             after:transition-transform hover:after:scale-x-100"
    >
      Yash Patel
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex gap-8 text-sm font-medium">
      {nav.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="relative
                   after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5
                   after:origin-left after:scale-x-0 after:bg-current
                   after:transition-transform hover:after:scale-x-100"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Theme toggle -->
    <ThemeToggle />

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      class="md:hidden p-2 ml-2 -mr-2 rounded-full z-50 relative
             text-[color:var(--text)]
             hover:bg-black/5 dark:hover:bg-white/10"
      aria-label="Open navigation"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round"
      >
        <path d="M3 6h18M3 12h18M3 18h18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile slide-down (will be portaled out of the header at runtime) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden
           bg-[color:var(--bg)]/90 dark:bg-[color:var(--bg)]/90
           backdrop-blur-md"
  >
    <ul class="flex flex-col divide-y divide-black/5 dark:divide-white/5">
      {nav.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="block px-6 py-0.5
                   hover:bg-black/5 dark:hover:bg-white/10"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.querySelector("header");
    const panel  = document.getElementById("mobile-menu");
    const btn    = document.getElementById("menu-btn");
    const height = header.getBoundingClientRect().height;

    // “Portal” the panel out so it isn’t clipped
    document.body.appendChild(panel);
    Object.assign(panel.style, {
      position: "fixed",
      top:    `${height}px`,
      left:   "0",
      right:  "0",
      zIndex: "40",
    });

    // Helper to toggle
    function toggleMenu() {
      panel.classList.toggle("hidden");
      btn.querySelector("svg")?.classList.toggle("rotate-90");
    }

    // Open/close when you tap the button
    btn.addEventListener("click", (e) => {
      e.stopPropagation();    // don’t also trigger the document listener
      toggleMenu();
    });

    // Prevent clicks _inside_ the menu from bubbling up and closing it
    panel.addEventListener("click", (e) => e.stopPropagation());

    // Close the menu when clicking anywhere else
    document.addEventListener("click", () => {
      if (!panel.classList.contains("hidden")) {
        panel.classList.add("hidden");
        btn.querySelector("svg")?.classList.remove("rotate-90");
      }
    });
  });
</script>

</header>
