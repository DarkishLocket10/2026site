  @media (max-width: 520px) {
    .gallery-fx-panel {
      right: 8px;
      width: calc(100vw - 24px);
      max-width: 296px;
    }
    .gallery-fx-row {
      padding: 11px 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-fx-settings,
    .gallery-fx-panel,
    .gallery-fx-switch-thumb,
    .gallery-fx-switch-track,
