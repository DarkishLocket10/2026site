---
type WorkItem = {
  imageSrc: string;
  link:     string;
  altText:  string;
  label:    string;
};

interface Props {
  title?: string;
  items?: WorkItem[];
}

const { title = 'Work', items = [] }: Props = Astro.props;
---

<section id="work" class="mx-auto max-w-7xl px-6 py-5">
  <!-- Heading -->
  <h2
    class="
      text-4xl font-semibold
      opacity-0 translate-x-6
      transition-all duration-700 ease-out delay-300
      motion-reduce:opacity-100 motion-reduce:translate-x-0
    "
    data-fade
  >
    {title}
  </h2>

  <!-- Grid of cards -->
  <div
    class="
      grid gap-6
      grid-cols-[repeat(auto-fit,minmax(14rem,1fr))]
      opacity-0 translate-x-6
      transition-all duration-700 ease-out delay-300
      motion-reduce:opacity-100 motion-reduce:translate-x-0
    "
    data-fade
  >
    {items.map(({ imageSrc, link, altText, label }) => (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={label}
        class="block"
        data-tilt
        style="perspective: 800px;"
      >
        <div
          class="
            tilt-content
            flex flex-col h-full overflow-hidden rounded-lg
            bg-current/5
            border border-gray-200 dark:border-gray-700
            shadow-sm
            transition-transform transition-shadow duration-400 ease-out
            hover:scale-105
          "
          style="aspect-ratio:5/8.2;"
        >
          
        
        
        {altText && (
        <div class="px-4 pt-2">
          <p class="text-xs italic text-current/70 text-center truncate">
            {altText}
          </p>
        </div>
        )}

    <div class="flex-shrink-0 p-4">
      <div class="w-full aspect-[32/10.5] overflow-hidden rounded-lg border-b-4 border-current/20">
        <img
          src={imageSrc}
          alt={altText}
          loading="lazy"
          class="w-full h-full object-cover" 
        />
      </div>
    </div>


          <div class="mt-[3px] px-4 text-left flex-1 overflow-y-auto scrollbar">
            <p class="text-sm font-medium text-current whitespace-pre-wrap">
              {label}
            </p>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
