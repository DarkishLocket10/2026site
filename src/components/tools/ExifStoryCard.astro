      'ledger-blueprint': { bg:'#EEF0F4', text:'#1A2332', accent:'#2563EB', muted:'#B0B8C4', border:'#C8D0DC' },
      'ledger-scope':     { bg:'#0A0E08', text:'#78D44C', accent:'#B8E06A', muted:'#283820', border:'#1C2A14' },
