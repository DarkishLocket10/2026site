  :root.dark .gallery-fx-reset {
    border-color: rgba(255, 255, 255, 0.12);
  }
  .gallery-fx-reset svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
