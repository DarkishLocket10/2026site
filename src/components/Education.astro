---
/*
  Props:
    - title?: string           // section heading (defaults to "Education")
    - items: Array<{
        years:   string;       // e.g. "2020–2025"
        institution: string;   // e.g. "Queen's University"
        details: string;       // e.g. "Bachelor of Computing (Honours)…"
      }>
*/
type EducationItem = {
  years: string;
  institution: string;
  details: string;
  crest?: string;
  crestAlt?: string;
};

const {items = [] }: { title?: string; items?: EducationItem[] } = Astro.props;
---

<section id="education" class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 xl:px-12 2xl:px-16 pt-0 pb-6
  opacity-0 -translate-x-6
  transition-all duration-700 ease-out
  motion-reduce:opacity-100 motion-reduce:translate-y-0
  "
    data-fade>
  <h2 class="text-4xl font-semibold mb-6">Education</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    {items.map(({ years, institution, details, crest, crestAlt }) => (
      <div class="flex items-start gap-5">
        {crest && (
          <figure class="education-crest w-20 h-20 md:w-24 md:h-24 shrink-0 relative m-0">
            <img
              src={crest}
              alt={crestAlt ?? `${institution} crest`}
              loading="lazy"
              class="education-crest-img"
            />
          </figure>
        )}
        <div class="flex-1 min-w-0">
          <span class="text-sm inline-flex items-center gap-1.5 opacity-85">
            <svg
              class="education-years-icon"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/>
              <path d="M22 10v6"/>
              <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>
            </svg>
            {years}
          </span>
          <h3 class="!mt-2 !text-3xl font-semibold ">
            {institution}
          </h3>
          <h4>
          {details}
          </h4>
        </div>
      </div>
    ))}

  <style>

h4 {
  font-size: clamp(.9rem, calc(.7rem + 1vw), 1rem);
  font-weight: 400;
  margin-top: -.25rem;
}

/* Default state: monochrome, high-contrast so internal lines and shapes are
   still readable (unlike a flat mask silhouette, which collapses every
   non-transparent pixel to a single colour). Hover reveals the full palette. */
.education-crest-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: grayscale(1) contrast(1.15) brightness(1.05);
  opacity: 0.78;
  transition: filter 320ms ease, opacity 320ms ease;
}

.education-crest:hover .education-crest-img,
.education-crest:focus-within .education-crest-img {
  filter: none;
  opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
  .education-crest-img {
    transition: none;
  }
}

</style>

  </div>
</section>
