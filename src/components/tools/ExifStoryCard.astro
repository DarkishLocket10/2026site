      'transit-boarding':'Boarding Pass','transit-jr':'JR Rail','transit-metro':'Metro Night',
      'journal-kraft':'Kraft','journal-weathered':'Weathered','journal-expedition':'Expedition',
      'edit-aperture':'Aperture','edit-natgeo':'National Geo','edit-noir':'Noir Editorial'
    };

    function buildPaletteGrid() {
      if (!ppScroll) return;
      ppScroll.innerHTML = '';
      PP_GROUPS.forEach(function(group) {
        var groupEl = document.createElement('div');
        groupEl.className = 'esc-pp-group';
        var labelEl = document.createElement('span');
        labelEl.className = 'esc-pp-group-label';
        labelEl.textContent = group.label;
        groupEl.appendChild(labelEl);
        var gridEl = document.createElement('div');
        gridEl.className = 'esc-pp-grid';
        group.keys.forEach(function(key) {
          var p = PALETTE_PRESETS[key];
          if (!p) return;
          var card = document.createElement('button');
          card.type = 'button';
          card.className = 'esc-pp-card';
          card.dataset.key = key;
          card.title = PP_NAMES[key] || key;
          card.style.background = p.bg;
          var bar = document.createElement('span');
          bar.className = 'esc-pp-card-accent-bar';
          bar.style.background = p.accent;
          var body = document.createElement('span');
          body.className = 'esc-pp-card-body';
          body.style.background = p.bg;
          var name = document.createElement('span');
          name.className = 'esc-pp-card-name';
          name.style.color = p.text;
          name.textContent = PP_NAMES[key] || key;
          body.appendChild(name);
          card.appendChild(bar);
          card.appendChild(body);
          card.addEventListener('click', function() { selectPalettePreset(key); });
          gridEl.appendChild(card);
        });
        groupEl.appendChild(gridEl);
        ppScroll.appendChild(groupEl);
      });
    }

    function selectPalettePreset(key) {
      currentPaletteKey = key;
      applyPalettePreset(key);
      updatePpToggle(key);
      var cards = ppPanel ? ppPanel.querySelectorAll('.esc-pp-card') : [];
      cards.forEach(function(c) { c.classList.toggle('esc-pp-selected', c.dataset.key === key); });
      closePpPanel();
    }

    function clearPaletteSelection() {
      if (!currentPaletteKey) return;
      currentPaletteKey = '';
      updatePpToggle('');
      var cards = ppPanel ? ppPanel.querySelectorAll('.esc-pp-card') : [];
      cards.forEach(function(c) { c.classList.remove('esc-pp-selected'); });
    }

    function updatePpToggle(key) {
      var p = key ? PALETTE_PRESETS[key] : null;
      if (ppNameEl) ppNameEl.textContent = key ? (PP_NAMES[key] || key) : 'Custom';
      if (ppDotBg)  ppDotBg.style.background  = p ? p.bg     : bgInput.value;
      if (ppDotAcc) ppDotAcc.style.background  = p ? p.accent : accentInput.value;
      if (ppDotMut) ppDotMut.style.background  = p ? p.muted  : mutedInput.value;
    }

    function closePpPanel() {
      if (ppPanel)     ppPanel.classList.remove('esc-pp-open');
      if (ppToggleBtn) ppToggleBtn.setAttribute('aria-expanded', 'false');
    }

    /* ── Canvas drawing helpers ── */
    function roundRect(x,y,w,h,r) {
      r = Math.min(r, w/2, h/2);
      ctx.beginPath();
      ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r);
      ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath();
    }
    function fillRect(x,y,w,h,r,f) { ctx.save(); ctx.fillStyle=f; roundRect(x,y,w,h,r); ctx.fill(); ctx.restore(); }
    function strokeRect(x,y,w,h,r,s,lw) { ctx.save(); ctx.strokeStyle=s; ctx.lineWidth=lw; roundRect(x,y,w,h,r); ctx.stroke(); ctx.restore(); }

    /* ── Proportional spacing helpers ── */
    function base(W) { return Math.round(W * 0.0074); } // ~8px at 1080w

    function drawBg(W, H) {
      ctx.clearRect(0, 0, W, H);
      fillRect(0, 0, W, H, 0, bgInput.value);
      if (grainInput.checked) {
        ctx.save();
        ctx.globalAlpha = 0.045;
        ctx.globalCompositeOperation = 'overlay';
        var grainCount = Math.round(W * H / 5000);
        for (var i=0; i<grainCount; i++) {
          ctx.fillStyle = i%2===0 ? '#ffffff' : '#000000';
          ctx.fillRect(Math.random()*W, Math.random()*H, 1, 1);
        }
        ctx.restore();
      }
      if (borderToggleInput.checked) {
        var inset = base(W) * 2;
        strokeRect(inset, inset, W-inset*2, H-inset*2, 24, withAlpha(borderInput.value, 0.3), 1);
      }
    }

    function drawPhoto(x, y, w, h, opts) {
      opts = opts || {};
      var r = opts.radius != null ? opts.radius : 20;
      var matteColor = opts.matte || mix(mutedInput.value, bgInput.value, 0.4);
      var bord = opts.border || borderInput.value;
      var alignX = opts.alignX != null ? opts.alignX : 0.5;
      var alignY = opts.alignY != null ? opts.alignY : pa();

      if (opts.shadow !== false) {
        ctx.save();
        ctx.shadowColor = 'rgba(0,0,0,0.18)';
        ctx.shadowBlur = 20; ctx.shadowOffsetY = 8;
        fillRect(x, y, w, h, r, matteColor);
        ctx.restore();
      }
      fillRect(x, y, w, h, r, matteColor);
      strokeRect(x, y, w, h, r, withAlpha(bord, 0.5), 1);

      if (!showImageInput.checked || !state.image) {
        ctx.save();
        ctx.fillStyle = mix(textInput.value, bgInput.value, 0.4);
        ctx.font = '400 20px '+lf().body+', sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(showImageInput.checked ? 'Upload a photo' : 'Image hidden', x+w/2, y+h/2);
        ctx.restore();
        return;
      }

      var ins = opts.inset != null ? opts.inset : 10;
      var ix = x+ins, iy = y+ins, iw = w-ins*2, ih = h-ins*2;
      ctx.save();
      roundRect(ix, iy, iw, ih, Math.max(8, r-4));
      ctx.clip();

      var imgW = state.image.naturalWidth||state.image.width;
      var imgH = state.image.naturalHeight||state.image.height;
      var scale = Math.max(iw/imgW, ih/imgH);
      var dw = imgW*scale, dh = imgH*scale;
      var dx = ix + (iw - dw) * alignX;
      var dy = iy + (ih - dh) * alignY;
      ctx.drawImage(state.image, dx, dy, dw, dh);

      if (opts.overlay) {
        var grad = ctx.createLinearGradient(ix, iy, ix, iy+ih);
        grad.addColorStop(0, withAlpha('#000000', 0));
        grad.addColorStop(1, withAlpha('#000000', opts.overlayAmt || 0.4));
        ctx.fillStyle = grad;
        ctx.fillRect(ix, iy, iw, ih);
      }
      ctx.restore();
    }

    function wrap(text, maxW, font, maxLines) {
      ctx.font = font;
      var words = String(text||'').split(/\s+/).filter(Boolean);
      if (!words.length) return [];
      var lines = [], cur = words[0];
      for (var i=1; i<words.length; i++) {
        var try_ = cur + ' ' + words[i];
        if (ctx.measureText(try_).width <= maxW) { cur = try_; }
        else { lines.push(cur); cur = words[i]; if (maxLines && lines.length >= maxLines-1) break; }
      }
      if (!maxLines || lines.length < maxLines) lines.push(cur);
      if (maxLines && lines.length === maxLines) {
        var last = lines[maxLines-1];
        while (ctx.measureText(last+'\u2026').width > maxW && last.length > 1) last = last.slice(0,-1).trim();
        if (String(text).length > lines.join(' ').length) lines[maxLines-1] = last + '\u2026';
      }
      return lines;
    }

    /* ── Font system ── */
    var FONT_MAP_TITLE = {
      serif:     '"Playfair Display", "Georgia", serif',
      sans:      '"Space Grotesk", Inter, system-ui, sans-serif',
      editorial: '"Cormorant Garamond", "Georgia", serif',
      grotesk:   '"Space Grotesk", system-ui, sans-serif'
    };
    var FONT_MAP_BODY = {
      sans:  'Inter, system-ui, sans-serif',
      serif: '"Cormorant Garamond", "Georgia", serif',
      mono:  '"DM Mono", "Space Mono", monospace'
    };
    var FONT_MONO   = '"DM Mono", "Space Mono", "SF Mono", monospace';
    var FONT_KICKER = '"Space Grotesk", Inter, system-ui, sans-serif';

    function FONT_TITLE() { return FONT_MAP_TITLE[titleFontInput.value] || FONT_MAP_TITLE.serif; }
    function FONT_BODY()  { return FONT_MAP_BODY[bodyFontInput.value] || FONT_MAP_BODY.sans; }
    function photoRatio() { return Number(photoRatioInput.value) / 100; }
    function cardPad()    { return Number(cardPaddingInput.value); }
    function overlayAmt() { return Number(overlayAmtInput.value) / 100; }
    function cornerR()    { return Number(cornerRadiusInput.value); }

    function updateRangeLabels() {
      if (photoRatioVal) photoRatioVal.textContent = photoRatioInput.value + '%';
      if (cardPaddingVal) cardPaddingVal.textContent = Number(cardPaddingInput.value) <= 30 ? 'Tight' : Number(cardPaddingInput.value) <= 50 ? 'Medium' : 'Generous';
      if (overlayAmtVal) overlayAmtVal.textContent = overlayAmtInput.value + '%';
      if (cornerRadiusVal) cornerRadiusVal.textContent = cornerRadiusInput.value + 'px';
      if (palSizeVal) palSizeVal.textContent = palSizeInput.value + 'px';
      if (extractPrecVal) {
        var prec = Number(extractPrecInput.value);
        extractPrecVal.textContent = prec <= 10 ? 'Fine' : prec <= 16 ? 'Medium' : prec <= 24 ? 'Coarse' : 'Broad';
      }
      if (extractSpreadVal) {
        var spread = Number(extractSpreadInput.value);
        extractSpreadVal.textContent = spread <= 28 ? 'Tight' : spread <= 48 ? 'Medium' : 'Wide';
      }
    }

    function drawLines(lines, x, y, lh, fill, font) {
      ctx.save(); ctx.fillStyle = fill; ctx.font = font;
      ctx.textBaseline = 'top';
      lines.forEach(function(l,i) { ctx.fillText(l, x, y + lh*i); });
      ctx.restore();
      return y + lh * lines.length;
    }

    /* ── Per-layout font overrides ── */
    var LAYOUT_FONTS = {
      street:    { kicker: '"Space Grotesk"', title: '"Space Grotesk"', body: 'Inter', mono: '"DM Mono"' },
      postcard:  { kicker: '"Libre Franklin"', title: '"Playfair Display"', body: '"Cormorant Garamond"', mono: '"DM Mono"' },
      ledger:    { kicker: '"Space Grotesk"', title: '"Space Grotesk"', body: 'Inter', mono: '"DM Mono"' },
      gallery:   { kicker: '"Libre Franklin"', title: '"Libre Franklin"', body: '"Libre Franklin"', mono: '"Libre Franklin"' },
      contact:   { kicker: '"DM Mono"', title: '"Space Grotesk"', body: '"DM Mono"', mono: '"DM Mono"' },
      transit:   { kicker: '"Space Grotesk"', title: '"Space Grotesk"', body: 'Inter', mono: '"DM Mono"' },
      journal:   { kicker: 'Caveat', title: 'Caveat', body: 'Caveat', mono: '"DM Mono"' },
      editorial: { kicker: '"Space Grotesk"', title: '"Playfair Display"', body: '"Cormorant Garamond"', mono: '"Space Grotesk"' }
    };
    var currentLayoutFonts = null;

    function lf() {
      return currentLayoutFonts || { kicker: FONT_KICKER, title: FONT_TITLE(), body: FONT_BODY(), mono: FONT_MONO };
    }

    function drawKicker(text, x, y, size) {
      if (!text) return y;
      size = size || 12;
      ctx.save();
      ctx.textBaseline = 'top';
      ctx.fillStyle = colorLabelInput ? colorLabelInput.value : accentInput.value;
      ctx.font = '700 '+size+'px '+lf().kicker+', system-ui, sans-serif';
      ctx.fillText(text.toUpperCase(), x, y);
      ctx.restore();
      return y + Math.round(size * 2.2);
    }

    function drawTitle(x, y, w, preset, maxLines) {
      var cursor = y;
      if (showTitleInput.checked && titleInput.value.trim()) {
        var sz = Math.round(preset.ts * ts());
        var font = '700 '+sz+'px '+lf().title+', Georgia, serif';
        var lh = Math.round((sz + 8) * ds());
        var titleColor = colorTitleInput ? colorTitleInput.value : textInput.value;
        cursor = drawLines(wrap(titleInput.value, w, font, maxLines||2), x, cursor, lh, titleColor, font);
        cursor += sc(6);
      }
      if (showSubtitleInput.checked && subtitleInput.value.trim()) {
        var ssz = Math.round(17 * ts());
        var sfont = '400 '+ssz+'px '+lf().body+', system-ui, sans-serif';
        var slh = Math.round((ssz + 6) * ds());
        var bodyColor = colorBodyInput ? colorBodyInput.value : mix(textInput.value, bgInput.value, 0.25);
        cursor = drawLines(wrap(subtitleInput.value, w, sfont, 2), x, cursor, slh, bodyColor, sfont);
        cursor += sc(4);
      }
      return cursor;
    }

    function drawCaption(x, y, w, maxLines, maxY, colorOverride) {
      if (!showStoryInput.checked || !captionInput.value.trim()) return y;
      if (maxY && y > maxY - 20) return y;
      var sz = Math.round(15 * ts());
      var font = '400 '+sz+'px '+lf().body+', system-ui, sans-serif';
      var lh = Math.round((sz + 8) * ds());
      var lines = wrap(captionInput.value, w, font, maxLines||3);
      if (maxY) {
        while (lines.length > 1 && y + lh * lines.length > maxY) lines.pop();
        if (y + lh > maxY) return y;
      }
      var captColor = colorOverride || (colorBodyInput ? colorBodyInput.value : mix(textInput.value, bgInput.value, 0.18));
      return drawLines(lines, x, y, lh, captColor, font);
    }

    function drawTags(tags, x, y, maxW, maxY) {
      if (!showTagsInput.checked || !tags.length) return y;
      if (maxY && y > maxY - 30) return y;
      var curX = x, curY = y;
      var sz = Math.round(12 * ts());
      ctx.font = '600 '+sz+'px '+lf().kicker+', sans-serif';
      var pillH = Math.round(sz + 12);
      var maxRows = 2; var rowCount = 0;
      for (var t = 0; t < tags.length; t++) {
        var tag = tags[t];
        var pw = ctx.measureText(tag).width + 20;
        if (curX + pw > x + maxW && curX > x) {
          curX = x; curY += pillH + 5; rowCount++;
          if (rowCount >= maxRows) break;
          if (maxY && curY + pillH > maxY) break;
        }
        fillRect(curX, curY, pw, pillH, pillH/2, mix(accentInput.value, bgInput.value, 0.78));
        ctx.save();
        ctx.textBaseline = 'middle';
        ctx.fillStyle = textInput.value;
        ctx.font = '600 '+sz+'px '+lf().kicker+', sans-serif';
        ctx.fillText(tag, curX + 10, curY + pillH/2);
        ctx.restore();
        curX += pw + 5;
      }
      return curY + pillH + 6;
    }

    function drawMeta(items, x, y, w, cols, rowH, maxY) {
      if (!showMetaInput.checked || !items.length) return y;
      if (maxY && y > maxY - 40) return y;
      cols = cols || 2;
      rowH = rowH || Math.round(56 * ds());
      var gap = 6;
      var cw = (w - gap * (cols-1)) / cols;
      // Limit items to what fits vertically
      if (maxY) {
        var maxRows = Math.max(1, Math.floor((maxY - y) / (rowH + gap)));
        var maxItems = maxRows * cols;
        if (items.length > maxItems) items = items.slice(0, maxItems);
      }
      items.forEach(function(it, i) {
        var col = i % cols, row = Math.floor(i / cols);
        var bx = x + col * (cw + gap);
        var by = y + row * (rowH + gap);
        fillRect(bx, by, cw, rowH, 12, mix(mutedInput.value, bgInput.value, 0.35));
        strokeRect(bx, by, cw, rowH, 12, withAlpha(borderInput.value, 0.2), 1);
        ctx.save();
        ctx.textBaseline = 'top';
        var metaColor = colorMetaInput ? colorMetaInput.value : textInput.value;
        ctx.fillStyle = mix(metaColor, bgInput.value, 0.38);
        ctx.font = '700 '+Math.round(9*ts())+'px '+lf().kicker+', sans-serif';
        ctx.fillText(it.label.toUpperCase(), bx+10, by+8);
        ctx.fillStyle = metaColor;
        var vsz = Math.round(13*ts());
        ctx.font = '500 '+vsz+'px '+lf().mono+', monospace';
        var vlines = wrap(it.value, cw-20, ctx.font, 2);
        vlines.forEach(function(l,li) { ctx.fillText(l, bx+10, by+24+li*(vsz+3)); });
        ctx.restore();
      });
      return y + Math.ceil(items.length / cols) * (rowH + gap);
    }

    function drawPalette(x, y, w, compact) {
      if (!showPaletteInput.checked) return y;
      var roles = ['dominant','accent','muted','shadow','highlight'];
      var gap = 4;
      var sw = (w - gap * (roles.length-1)) / roles.length;
      var sh = palSz();
      var labelSz = sh >= 50 ? 9 : 8;
      var hexSz   = sh >= 50 ? 9 : 8;
      var showHex = sh >= 36;
      var showLabel = sh >= 30;
      roles.forEach(function(role, i) {
        var c = state.palette[role] || '#888';
        var sx = x + i * (sw + gap);
        fillRect(sx, y, sw, sh, Math.min(8, sh/4), c);
        if (!showLabel) return;
        ctx.save();
        ctx.textBaseline = 'top';
        ctx.fillStyle = contrast(c);
        ctx.font = '700 '+labelSz+'px '+lf().kicker+',sans-serif';
        ctx.fillText(role.charAt(0).toUpperCase()+role.slice(1), sx+5, y+5);
        if (showHex) {
          ctx.font = '500 '+hexSz+'px '+lf().mono+',monospace';
          ctx.fillText(c.toUpperCase(), sx+5, y+5+labelSz+4);
        }
        ctx.restore();
      });
      return y + sh;
    }

    function drawLocation(x, y, w, maxY) {
      if (!showLocationInput.checked) return y;
      if (maxY && y > maxY - 30) return y;
      var hl = locationHeadline();
      var sl = locationSubline();
      if (!hl && !sl) return y;
      var labelSz = Math.round(9 * ts());
      var headSz = Math.round(14 * ts());
      var subSz = Math.round(11 * ts());
      var h = sl ? Math.round(22 + headSz + subSz + 10) : Math.round(22 + headSz + 6);
      if (maxY && y + h > maxY) return y;
      fillRect(x, y, w, h, 12, mix(mutedInput.value, bgInput.value, 0.3));
      strokeRect(x, y, w, h, 12, withAlpha(borderInput.value, 0.2), 1);
      ctx.save();
      ctx.textBaseline = 'top';
      ctx.fillStyle = accentInput.value;
      ctx.font = '700 '+labelSz+'px '+lf().kicker+', sans-serif';
      ctx.fillText('LOCATION', x+10, y+7);
      ctx.fillStyle = textInput.value;
      ctx.font = '600 '+headSz+'px '+lf().body+', sans-serif';
      var hlines = wrap(hl, w-20, ctx.font, 1);
      hlines.forEach(function(l) { ctx.fillText(l, x+10, y+7+labelSz+4); });
      if (sl) {
        ctx.fillStyle = mix(textInput.value, bgInput.value, 0.3);
        ctx.font = '400 '+subSz+'px '+lf().mono+', monospace';
        ctx.fillText(sl, x+10, y+7+labelSz+4+headSz+3);
      }
      ctx.restore();
      return y + h;
    }

    /* ── Renderers ── */

    function renderStreet(W, H, P) {
      var pad = sc(cardPad());
      var r = cornerR();
      var imgH = Math.round(H * photoRatio());
      drawPhoto(pad, pad, W - pad*2, imgH, { radius: r, overlay: true, overlayAmt: overlayAmt() });

      // Location chip on photo
      if (popt('shot-chip') && showLocationInput.checked && locationHeadline()) {
        var chipSz = Math.round(13*ts());
        ctx.font = '600 '+chipSz+'px '+lf().body+', sans-serif';
        var chipText = wrap(locationHeadline(), W * 0.45, ctx.font, 1)[0] || '';
        var chipW = ctx.measureText(chipText).width + 24;
        var chipX = pad + 16, chipY = pad + imgH - 54;
        fillRect(chipX, chipY, chipW, 36, 8, withAlpha(bgInput.value, 0.8));
        ctx.save(); ctx.textBaseline = 'middle';
        ctx.fillStyle = textInput.value;
        ctx.font = '600 '+chipSz+'px '+lf().body+', sans-serif';
        ctx.fillText(chipText, chipX+12, chipY+18);
        ctx.restore();
      }

      // Info panel
      var panGap = sc(10);
      var panY = pad + imgH + panGap;
      var panH = H - panY - pad + 4;
      var panX = pad + 8;
      var panW = W - pad*2 - 16;
      fillRect(panX, panY, panW, panH, Math.max(r-4, 8), mix(mutedInput.value, bgInput.value, 0.28));
      strokeRect(panX, panY, panW, panH, Math.max(r-4, 8), withAlpha(borderInput.value, 0.35), 1);

      // Thin accent line at top of panel
      ctx.save();
      ctx.fillStyle = withAlpha(accentInput.value, 0.5);
      roundRect(panX+20, panY, panW-40, 2, 1);
      ctx.fill();
      ctx.restore();

      var ix = panX + sc(24);
      var iw = panW - sc(48);
      var y = panY + sc(22);

      var palH = palSz();
      var palY = panY + panH - palH - sc(12);
      var contentBottom = palY - sc(6);

      y = drawKicker(getKickerText('Street Notes'), ix, y);
      y = drawTitle(ix, y, iw, P, 2);
      y += sc(6);
      y = drawCaption(ix, y, iw, 3, contentBottom);
      y += sc(8);
      y = drawTags(getTags(), ix, y, iw, contentBottom);
      y += sc(6);
      y = drawMeta(getMetaItems().slice(0,6), ix, y, iw, 3, Math.round(52*ds()), contentBottom);
      drawPalette(ix, palY, iw, true);
    }

    function renderPostcard(W, H, P) {
      var border = Math.round(cardPad() * 0.72);
      var r = cornerR();
      fillRect(border, border, W-border*2, H-border*2, r, mix(bgInput.value, textInput.value, 0.04));
      strokeRect(border, border, W-border*2, H-border*2, r, withAlpha(borderInput.value, 0.5), 1.5);

      // Airmail stripes - red and blue diagonal
      if (popt('airmail-stripe')) {
        var stripeH = 8;
        var sY = border;
        ctx.save();
        roundRect(border, border, W-border*2, 28, r);
        ctx.clip();
        for (var si=0; si < (W/16)+2; si++) {
          ctx.fillStyle = si%2===0 ? '#c0392b' : '#2c3e80';
          ctx.fillRect(border + si*16, sY, 8, stripeH);
        }
        ctx.restore();
        // Bottom stripe too
        ctx.save();
        roundRect(border, H-border-28, W-border*2, 28, r);
        ctx.clip();
        for (var si2=0; si2 < (W/16)+2; si2++) {
          ctx.fillStyle = si2%2===0 ? '#c0392b' : '#2c3e80';
          ctx.fillRect(border + si2*16, H-border-8, 8, stripeH);
        }
        ctx.restore();
      }

      var innerPad = Math.round(border * 0.9);
      var photoX = border + innerPad;
      var photoY = border + innerPad;
      var photoW = Math.round(W * photoRatio());
      var photoH = H - border*2 - innerPad*2;
      drawPhoto(photoX, photoY, photoW, photoH, { radius: Math.max(r-6,4), matte:'#f0eae0', border: mix('#e0d8cc', borderInput.value, 0.3), inset: 14, shadow:true });

      if (popt('postmark') && (dateInput.value.trim() || locationHeadline())) {
        var stW = 120, stH = 72;
        var stX = photoX + photoW - stW - 14;
        var stY = photoY + 14;
        fillRect(stX, stY, stW, stH, 12, withAlpha(accentInput.value, 0.85));
        ctx.save(); ctx.textBaseline = 'top';
        ctx.fillStyle = contrast(accentInput.value);
        ctx.font = '700 9px '+lf().kicker+', sans-serif';
        ctx.fillText('POSTMARK', stX+10, stY+8);
        ctx.font = '700 15px '+lf().mono+', monospace';
        ctx.fillText(dateInput.value || '', stX+10, stY+22);
        ctx.font = '400 10px '+lf().body+', sans-serif';
        var stLoc = wrap(locationHeadline(), stW-20, ctx.font, 2);
        stLoc.forEach(function(l,i) { ctx.fillText(l, stX+10, stY+42+i*12); });
        ctx.restore();
      }

      var px = photoX + photoW + sc(28);
      var pw = W - px - border - 20;
      var y = border + 40;
      var bottom = H - border - 20;

      var palH2 = palSz();
      var palY2 = Math.max(bottom - palH2, y);
      var contentBottom2 = palY2 - sc(6);

      y = drawKicker(getKickerText('Postcard'), px, y, 11);
      y = drawTitle(px, y, pw, P, 3);
      y += sc(10);
      y = drawLocation(px, y, pw, contentBottom2); y += sc(10);
      y = drawCaption(px, y, pw, 4, contentBottom2); y += sc(10);
      y = drawTags(getTags(), px, y, pw, contentBottom2); y += sc(6);
      y = drawMeta(getMetaItems().slice(0,6), px, y, pw, 2, Math.round(50*ds()), contentBottom2);
      palY2 = Math.max(y + sc(4), bottom - palH2);
      if (palY2 + palH2 <= bottom + 4) drawPalette(px, palY2, pw, true);
    }

    function renderLedger(W, H, P) {
      var pad = Math.round(cardPad() * 0.72);
      var panelW = Math.round(W * (1 - photoRatio() - 0.08));
      var panelLeft = popt('panel-side') !== 'right';

      var panX = panelLeft ? pad : W - pad - panelW;
      var imgX = panelLeft ? pad + panelW + 12 : pad;
      var imgW = W - pad*2 - panelW - 12;

      fillRect(panX, pad, panelW, H-pad*2, 22, mix(mutedInput.value, bgInput.value, 0.2));
      strokeRect(panX, pad, panelW, H-pad*2, 22, withAlpha(borderInput.value, 0.5), 1);
      drawPhoto(imgX, pad, imgW, H-pad*2, { radius: cornerR(), overlay: true, overlayAmt: overlayAmt(), alignX: 0.55 });

      if (showStoryInput.checked && captionInput.value.trim()) {
        var ovH = 78, ovY = H - pad - ovH;
        var ovX = imgX + 16, ovW = imgW - 32;
        fillRect(ovX, ovY, ovW, ovH, 14, withAlpha(bgInput.value, 0.72));
        ctx.save(); ctx.textBaseline = 'top';
        ctx.fillStyle = mix(textInput.value, bgInput.value, 0.08);
        ctx.font = '400 '+Math.round(13*ts())+'px '+lf().body+', sans-serif';
        var capLines = wrap(captionInput.value, ovW-24, ctx.font, 3);
        capLines.forEach(function(l,i) { ctx.fillText(l, ovX+12, ovY+12+i*Math.round(18*ds())); });
        ctx.restore();
      }

      var ix = panX + sc(24);
      var iw = panelW - sc(48);
      var y = pad + sc(32);
      var bottom = H - pad - sc(56);

      var palH3 = palSz();
      var contentBottom3 = bottom - palH3 - sc(6);

      y = drawKicker(getKickerText('Lens Ledger'), ix, y, 11);
      y = drawTitle(ix, y, iw, P, 3);
      y += sc(12);
      y = drawLocation(ix, y, iw, contentBottom3); y += sc(10);
      y = drawTags(getTags(), ix, y, iw, contentBottom3); y += sc(6);
      y = drawMeta(getMetaItems().slice(0,6), ix, y, iw, 1, Math.round(48*ds()), contentBottom3);
      drawPalette(ix, bottom - palH3, iw, true);
    }

    function renderGallery(W, H, P) {
      var r = cornerR();
      drawPhoto(28, 28, W-56, H-56, { radius: r, overlay: true, overlayAmt: Math.max(overlayAmt(), 0.4), inset: 0, matte: bgInput.value, shadow: false, alignY: 0.45 });

      var plaqueOp = popt('plaque-opacity') || 0.88;
      var px = 48, plaqueW = W - 96;
      var plaqueH = Math.round(H * 0.24);
      var plaqueY = H - 48 - plaqueH;
      fillRect(px, plaqueY, plaqueW, plaqueH, 22, withAlpha(mutedInput.value, plaqueOp));
      strokeRect(px, plaqueY, plaqueW, plaqueH, 22, withAlpha(borderInput.value, 0.5), 1);

      var lx = px + sc(28);
      var leftW = Math.round(plaqueW * 0.54);
      var y = plaqueY + sc(24);

      var plaqueBottom4 = plaqueY + plaqueH - sc(8);
      var palH4 = palSz();
      var palMaxY4 = plaqueBottom4 - palH4;
      var contentBottom4 = palMaxY4 - sc(6);

      y = drawKicker(getKickerText('Gallery Plaque'), lx, y, 11);
      y = drawTitle(lx, y, leftW, P, 2);
      y += sc(6);
      var galPalY = Math.min(Math.max(y, palMaxY4), plaqueBottom4 - palH4);
      drawPalette(lx, galPalY, leftW, true);

      var rx = px + leftW + sc(40);
      var rw = plaqueW - leftW - sc(68);
      var ry = plaqueY + sc(24);
      ry = drawLocation(rx, ry, rw, contentBottom4); ry += sc(8);
      drawMeta(getMetaItems().slice(0,4), rx, ry, rw, 1, Math.round(44*ds()), contentBottom4);
    }

    function renderContact(W, H, P) {
      var pad = Math.round(cardPad() * 0.9);
      fillRect(pad, pad, W-pad*2, H-pad*2, 22, mix(mutedInput.value, bgInput.value, 0.12));
      strokeRect(pad, pad, W-pad*2, H-pad*2, 22, withAlpha(borderInput.value, 0.4), 1);

      var hx = pad + 20;
      ctx.save(); ctx.textBaseline = 'top';
      ctx.fillStyle = colorLabelInput ? colorLabelInput.value : accentInput.value;
      ctx.font = '700 '+Math.round(11*ts())+'px '+lf().kicker+', sans-serif';
      ctx.fillText(getKickerText('Contact Sheet').toUpperCase(), hx, pad+12);
      ctx.fillStyle = colorMetaInput ? mix(colorMetaInput.value, bgInput.value, 0.2) : mix(textInput.value, bgInput.value, 0.25);
      ctx.font = '500 '+Math.round(11*ts())+'px '+lf().mono+', monospace';
      var dateStr = dateInput.value || '';
      if (dateStr) ctx.fillText(dateStr, W-pad-20-ctx.measureText(dateStr).width, pad+12);
      ctx.restore();

      if (popt('film-border')) {
        var sprY = pad + 38;
        ctx.fillStyle = withAlpha(borderInput.value, 0.5);
        ctx.fillRect(hx, sprY, W-pad*2-40, 2);
        for (var si=0; si < Math.floor((W-pad*2-40)/20); si++) {
          fillRect(hx + si*20 + 4, sprY - 4, 8, 10, 2, withAlpha(borderInput.value, 0.25));
        }
      }

      var phY = pad + 52;
      var phH = Math.round((H - pad*2 - 52) * 0.44);
      drawPhoto(hx, phY, W-pad*2-40, phH, { radius: 18, overlay: true, overlayAmt: 0.25, inset: 8, alignX: 0.5, alignY: pa() });

      var stY = phY + phH + 10;
      var stH = Math.round((H-pad*2-52) * 0.14);
      var stGap = 10;
      var stW = (W-pad*2-40 - stGap*2) / 3;
      drawPhoto(hx, stY, stW, stH, { radius: 14, inset: 6, alignX: 0.2, shadow: false, matte: mix(bgInput.value,mutedInput.value,0.3) });
      drawPhoto(hx+stW+stGap, stY, stW, stH, { radius: 14, inset: 6, alignX: 0.5, shadow: false, matte: mix(bgInput.value,mutedInput.value,0.3) });
      drawPhoto(hx+(stW+stGap)*2, stY, stW, stH, { radius: 14, inset: 6, alignX: 0.8, shadow: false, matte: mix(bgInput.value,mutedInput.value,0.3) });

      if (popt('film-border')) {
        var sprY2 = stY + stH + 8;
        ctx.fillStyle = withAlpha(borderInput.value, 0.5);
        ctx.fillRect(hx, sprY2, W-pad*2-40, 2);
        for (var si2=0; si2 < Math.floor((W-pad*2-40)/20); si2++) {
          fillRect(hx + si2*20 + 4, sprY2 - 4, 8, 10, 2, withAlpha(borderInput.value, 0.25));
        }
      }

      var textY = stY + stH + 22;
      var textW = (W - pad*2 - 40);
      var leftW = Math.round(textW * 0.55);
      var rightX = hx + leftW + 20;
      var rightW = textW - leftW - 20;
      var y = textY;
      var contactBottom = H - pad - sc(8);
      var palH5 = palSz();
      var contactPalY = contactBottom - palH5;
      var contentBottom5 = contactPalY - sc(4);

      y = drawKicker(getKickerText('Contact Sheet'), hx, y, 11);
      y = drawTitle(hx, y, leftW, P, 2);
      y += sc(6);
      y = drawCaption(hx, y, leftW, 3, contentBottom5);
      y += sc(6);
      y = drawTags(getTags(), hx, y, leftW, contentBottom5);

      drawLocation(rightX, textY, rightW, contentBottom5);
      drawPalette(rightX, contactPalY, rightW, true);
    }

    function renderTransit(W, H, P) {
      var pad = Math.round(cardPad() * 0.82);
      var bandW = Math.round(W * 0.065);
      var bandLeft = popt('band-side') !== 'right';

      fillRect(pad, pad, W-pad*2, H-pad*2, 22, mix(mutedInput.value, bgInput.value, 0.15));
      strokeRect(pad, pad, W-pad*2, H-pad*2, 22, withAlpha(accentInput.value, 0.6), 2);

      var bandX = bandLeft ? pad+10 : W-pad-10-bandW;
      fillRect(bandX, pad+10, bandW, H-pad*2-20, 16, mix(accentInput.value, bgInput.value, 0.2));
      ctx.save();
      ctx.translate(bandX + bandW/2, H/2 + 90);
      ctx.rotate(-Math.PI/2);
      ctx.fillStyle = textInput.value;
      ctx.font = '800 '+Math.round(30*ts())+'px '+lf().kicker+', sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('TRANSIT PASS', 0, 0);
      ctx.restore();

      var perfX = bandLeft ? pad + bandW + 20 : W - pad - bandW - 20;
      ctx.save();
      ctx.strokeStyle = withAlpha(borderInput.value, 0.35);
      ctx.setLineDash([6, 6]);
      ctx.beginPath();
      ctx.moveTo(perfX, pad + 16);
      ctx.lineTo(perfX, H - pad - 16);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();

      var photoX = bandLeft ? pad + bandW + 32 : pad + 16;
      var photoW = Math.round((W - pad*2 - bandW - 32) * 0.48);
      drawPhoto(photoX, pad+16, photoW, H-pad*2-32, { radius: 18, overlay: true, overlayAmt: 0.2, alignX: 0.5 });

      var infoX = bandLeft ? photoX + photoW + sc(24) : pad + photoW + 32 + sc(24);
      var infoW = W - infoX - pad - 16;
      if (!bandLeft) { infoX = pad + 16; infoW = photoX - pad - 32; }

      var y = pad + sc(40);
      var bottom = H - pad - sc(20);
      var palH6 = palSz();
      var transitPalY = bottom - palH6;
      var contentBottom6 = transitPalY - sc(6);

      y = drawKicker(getKickerText('Transit Pass'), infoX, y, 11);
      y = drawTitle(infoX, y, infoW, P, 3);
      y += sc(10);
      y = drawLocation(infoX, y, infoW, contentBottom6); y += sc(8);
      y = drawTags(getTags(), infoX, y, infoW, contentBottom6); y += sc(6);
      y = drawMeta(getMetaItems().slice(0,4), infoX, y, infoW, 1, Math.round(48*ds()), contentBottom6);
      if (y + palH6 <= bottom + 4) drawPalette(infoX, Math.max(y + sc(4), transitPalY), infoW, true);
    }

    function renderJournal(W, H, P) {
      var pad = sc(cardPad());
      var innerBg = mix('#f4ece0', bgInput.value, 0.12);
      fillRect(pad, pad, W-pad*2, H-pad*2, 18, innerBg);
      strokeRect(pad, pad, W-pad*2, H-pad*2, 18, withAlpha(borderInput.value, 0.4), 1);

      if (popt('ruled-lines')) {
        var lineGap = sc(64);
        for (var li=1; li < Math.floor((H-pad*2)/lineGap); li++) {
          ctx.strokeStyle = withAlpha(borderInput.value, 0.1);
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(pad+28, pad + li*lineGap);
          ctx.lineTo(W-pad-28, pad + li*lineGap);
          ctx.stroke();
        }
      }

      var imgMargin = Math.round(W * 0.038);
      var imgX = pad + imgMargin;
      var imgW = W - pad*2 - imgMargin*2;
      var imgH = Math.round(H * photoRatio());
      var imgTopPad = sc(36);
      drawPhoto(imgX, pad + imgTopPad, imgW, imgH, { radius: 16, matte: '#f0e8da', border: mix(borderInput.value, '#d4c8b8', 0.3), inset: 10, alignY: pa() });

      var y = pad + imgTopPad + imgH + sc(18);
      var ix = imgX;
      var iw = imgW;
      var bottom = H - pad - sc(20);

      var palH7 = palSz();
      var journalPalY = bottom - palH7;
      var contentBottom7 = journalPalY - sc(6);

      // Derive readable text colours for the cream journal page
      var journalPageLum = lum(innerBg);
      var journalCapColor = journalPageLum > 0.35
        ? mix(colorBodyInput ? colorBodyInput.value : textInput.value, '#1a1008', 0.7)
        : (colorBodyInput ? colorBodyInput.value : mix(textInput.value, bgInput.value, 0.18));

      y = drawKicker(getKickerText('Field Journal'), ix, y, Math.round(13 * ts()));
      y = drawTitle(ix, y, iw, P, 2);
      y += sc(10);
      y = drawCaption(ix, y, iw, 4, contentBottom7, journalCapColor);
      y += sc(10);
      y = drawLocation(ix, y, iw, contentBottom7); y += sc(8);
      y = drawTags(getTags(), ix, y, iw, contentBottom7); y += sc(6);
      y = drawMeta(getMetaItems().slice(0,6), ix, y, iw, 2, Math.round(50*ds()), contentBottom7);
      if (y + palH7 <= bottom + 4) drawPalette(ix, Math.max(y + sc(4), journalPalY), iw, true);
    }

    function renderEditorial(W, H, P) {
      var pad = Math.round(cardPad() * 0.82);
      var r = cornerR();
      var imgLeft = popt('img-side') !== 'right';
      var imgW = Math.round(W * (photoRatio() + 0.12));

      fillRect(pad-4, pad-4, W-pad*2+8, H-pad*2+8, r, mix(mutedInput.value, bgInput.value, 0.1));

      var imgX = imgLeft ? pad : W - pad - imgW;
      drawPhoto(imgX, pad, imgW, H-pad*2, { radius: 16, overlay: true, overlayAmt: 0.15, inset: 0, matte: bgInput.value, shadow: false, alignX: 0.45 });

      if (popt('fold-line')) {
        var foldX = imgLeft ? pad + imgW + 8 : W - pad - imgW - 8;
        ctx.save();
        ctx.strokeStyle = withAlpha(borderInput.value, 0.25);
        ctx.setLineDash([8, 8]);
        ctx.beginPath();
        ctx.moveTo(foldX, pad + 10);
        ctx.lineTo(foldX, H - pad - 10);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.restore();
      }

      var tx = imgLeft ? pad + imgW + sc(28) : pad + sc(20);
      var tw = W - imgW - pad*2 - sc(40);
      var y = pad + sc(36);
      var bottom = H - pad - sc(20);

      var palH8 = palSz();
      var editPalY = bottom - palH8;
      var contentBottom8 = editPalY - sc(6);

      y = drawKicker(getKickerText('Editorial'), tx, y, 11);
      y = drawTitle(tx, y, tw, P, 3);
      y += sc(12);
      y = drawCaption(tx, y, tw, 4, contentBottom8);
      y += sc(12);
      y = drawLocation(tx, y, tw, contentBottom8); y += sc(10);
      y = drawTags(getTags(), tx, y, tw, contentBottom8); y += sc(8);
      y = drawMeta(getMetaItems().slice(0,4), tx, y, tw, 1, Math.round(50*ds()), contentBottom8);
      if (y + palH8 <= bottom + 4) drawPalette(tx, Math.max(y + sc(4), editPalY), tw, true);
    }

    /* ── Main render ── */
    function renderCard() {
      var W = Math.max(600, Number(widthInput.value) || 1080);
      var H = Math.max(600, Number(heightInput.value) || 1080);
      canvas.width = W; canvas.height = H;
      canvas.style.boxShadow = shadowInput.checked ? '0 12px 40px rgba(0,0,0,0.15)' : 'none';
      drawBg(W, H);

      var P = PRESETS[presetInput.value] || PRESETS['street-notes'];
      var layout = P.layout;
      currentLayoutFonts = LAYOUT_FONTS[layout] || null;
      if      (layout === 'postcard')  renderPostcard(W, H, P);
      else if (layout === 'ledger')    renderLedger(W, H, P);
      else if (layout === 'gallery')   renderGallery(W, H, P);
      else if (layout === 'contact')   renderContact(W, H, P);
      else if (layout === 'transit')   renderTransit(W, H, P);
      else if (layout === 'journal')   renderJournal(W, H, P);
      else if (layout === 'editorial') renderEditorial(W, H, P);
      else                             renderStreet(W, H, P);
      currentLayoutFonts = null;
    }

    /* ── Caption builder ── */
    function buildCaption() {
      var parts = [];
      if (showTitleInput.checked && titleInput.value.trim()) parts.push(titleInput.value.trim());
      if (showStoryInput.checked && captionInput.value.trim()) parts.push(captionInput.value.trim());
      var meta = [cameraInput.value, lensInput.value, focalInput.value, apertureInput.value, shutterInput.value, isoInput.value].filter(Boolean).join(' \u2022 ');
      if (showMetaInput.checked && meta) parts.push(meta);
      if (showLocationInput.checked && getLocationDisplay()) parts.push(getLocationDisplay());
      if (dateInput.value.trim()) parts.push(dateInput.value.trim());
      return parts.filter(Boolean).join('\n');
    }

    /* ── Preset change ── */
    function applyPreset() {
      var P = PRESETS[presetInput.value];
      if (!P) return;
      widthInput.value = String(P.w);
      heightInput.value = String(P.h);
      buildPresetOpts();
      renderCard();
    }

    /* ── Export ── */
    async function download() {
      renderCard();
      var a = document.createElement('a');
      var fmt = formatInput.value;
      a.download = (state.fileName ? cleanTitle(state.fileName).replace(/\s+/g,'-').toLowerCase() : 'story-card') + '.' + (fmt==='jpeg'?'jpg':'png');
      a.href = fmt==='jpeg' ? canvas.toDataURL('image/jpeg', Number(qualityInput.value)/100) : canvas.toDataURL('image/png');
      a.click();
      setStatus('Downloaded.');
    }

    async function copyCard() {
      if (!navigator.clipboard || typeof ClipboardItem === 'undefined') { setStatus('Clipboard not supported.'); return; }
      renderCard();
      var fmt = formatInput.value === 'jpeg' ? 'image/jpeg' : 'image/png';
      canvas.toBlob(async function(blob) {
        if (!blob) { setStatus('Copy failed.'); return; }
        try { await navigator.clipboard.write([new ClipboardItem({[fmt]:blob})]); setStatus('Copied!'); }
        catch(e) { console.error(e); setStatus('Copy failed.'); }
      }, fmt, Number(qualityInput.value)/100);
    }

    async function copyCaptionText() {
      if (!navigator.clipboard) { setStatus('Clipboard not supported.'); return; }
      try { await navigator.clipboard.writeText(buildCaption()); setStatus('Caption copied!'); }
      catch(e) { console.error(e); setStatus('Copy failed.'); }
    }

    function clearImage() {
      revokeUrl(); state.image = null; state.fileName = '';
      state.exifRaw = null; state.gpsRaw = null;
      thumb.removeAttribute('src'); nameEl.textContent = '';
      fileInput.value = ''; setDropzone(false);
      setStatus(''); renderCard();
    }

    /* ── Wire up ── */
    syncColor(bgInput, bgHex);
    syncColor(textInput, textHex);
    syncColor(accentInput, accentHex);
    syncColor(mutedInput, mutedHex);
    syncColor(borderInput, borderHex);
    if (colorLabelInput) syncColor(colorLabelInput, colorLabelHex);
    if (colorTitleInput) syncColor(colorTitleInput, colorTitleHex);
    if (colorBodyInput)  syncColor(colorBodyInput,  colorBodyHex);
    if (colorMetaInput)  syncColor(colorMetaInput,  colorMetaHex);
    updateSwatches();

    fileInput.addEventListener('change', function() { handleFile(fileInput.files && fileInput.files[0]); });
    dropzone.addEventListener('click', function(e) { if (e.target === removeBtn) return; fileInput.click(); });
    dropzone.addEventListener('keydown', function(e) { if (e.key==='Enter'||e.key===' ') { e.preventDefault(); fileInput.click(); } });
    ['dragenter','dragover'].forEach(function(ev) { dropzone.addEventListener(ev, function(e) { e.preventDefault(); dropzone.classList.add('esc-drag-over'); }); });
    ['dragleave','dragend','drop'].forEach(function(ev) { dropzone.addEventListener(ev, function(e) { e.preventDefault(); dropzone.classList.remove('esc-drag-over'); }); });
    dropzone.addEventListener('drop', function(e) { handleFile(e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]); });
    document.addEventListener('paste', function(e) {
      if (!root.isConnected) return;
      var items = e.clipboardData && e.clipboardData.items;
      if (!items) return;
      for (var i=0; i<items.length; i++) { if (items[i].type.indexOf('image/')===0) { handleFile(items[i].getAsFile()); return; } }
    });
    removeBtn.addEventListener('click', function(e) { e.stopPropagation(); clearImage(); });
    autoFillBtn.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); fillFromExif(); renderCard(); setStatus(state.exifRaw ? 'Filled from EXIF.' : 'No EXIF data.'); });
    copyCaptionBtn.addEventListener('click', copyCaptionText);
    presetInput.addEventListener('change', applyPreset);
    formatInput.addEventListener('change', function() { qualityWrap.style.display = formatInput.value==='jpeg' ? '' : 'none'; });
    extractPaletteBtn.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); extractPalette(); renderCard(); });
    applyPaletteBtn.addEventListener('click', function() { applyPalette(); });
    // Palette preset picker toggle
    if (ppToggleBtn && ppPanel) {
      ppToggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = ppPanel.classList.toggle('esc-pp-open');
        ppToggleBtn.setAttribute('aria-expanded', String(open));
      });
      ppPanel.addEventListener('click', function(e) { e.stopPropagation(); });
      document.addEventListener('click', function() { closePpPanel(); });
    }
    buildPaletteGrid();
    updatePpToggle('');

    [titleInput, subtitleInput, captionInput, locationInput, tagsInput,
     cameraInput, lensInput, focalInput, apertureInput, shutterInput, isoInput, dateInput,
     widthInput, heightInput, typeScaleInput, densityInput, photoAlignInput,
     layoutLabelInput,
     titleFontInput, bodyFontInput, photoRatioInput, cardPaddingInput,
     overlayAmtInput, cornerRadiusInput, palSizeInput,
     extractPrecInput, extractSpreadInput,
     colorLabelInput, colorTitleInput, colorBodyInput, colorMetaInput,
     showImageInput, showLabelInput, showTitleInput, showSubtitleInput, showPaletteInput,
     showStoryInput, showTagsInput, showLocationInput, showMetaInput,
     shadowInput, grainInput, borderToggleInput, qualityInput
    ].forEach(function(el) {
      el.addEventListener('input', function() { updateRangeLabels(); renderCard(); });
      el.addEventListener('change', function() { updateRangeLabels(); renderCard(); });
    });

    downloadBtn.addEventListener('click', download);
    copyBtn.addEventListener('click', copyCard);

    buildPresetOpts();
    updateRangeLabels();
    resetFontColors();
    applyPreset();
    renderCard();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExifStoryCard, { once: true });
  } else {
    initExifStoryCard();
  }
  document.addEventListener('astro:page-load', initExifStoryCard);
</script>
