    top: 36px;
    right: 12px;
    z-index: 7;
    width: 296px;
    padding: 14px 16px 12px;
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-xl);
