  .gallery-fx-row:hover,
  .gallery-fx-row:focus-within {
    background: rgba(0, 0, 0, 0.04);
  }
  :root.dark .gallery-fx-row:hover,
  :root.dark .gallery-fx-row:focus-within {
    background: rgba(255, 255, 255, 0.05);
  }
  .gallery-fx-row + .gallery-fx-row {
    box-shadow: 0 -1px 0 rgba(0, 0, 0, 0.06);
  }
  :root.dark .gallery-fx-row + .gallery-fx-row {
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.06);
  }
  .gallery-fx-row-icon {
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-text-soft);
    transition: background 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  :root.dark .gallery-fx-row-icon {
    background: rgba(255, 255, 255, 0.06);
  }
  .gallery-fx-row:hover .gallery-fx-row-icon {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
