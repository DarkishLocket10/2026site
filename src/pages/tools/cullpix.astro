<script is:inline>
  /* OS detection: promote the matching button, demote the other to outline. */
  (function () {
    var ua = navigator.userAgent || '';
    var plat =
      (navigator.userAgentData && navigator.userAgentData.platform) ||
      navigator.platform || '';
    var isWindows = /win/i.test(plat) || /windows/i.test(ua);
    // Treat anything else (incl. unknown) as macOS-primary only when it really is a Mac;
    // otherwise leave both buttons solid so no platform is wrongly demoted.
    var isMac = /mac/i.test(plat) || /mac os x/i.test(ua);

    function demote(el) {
      if (!el) return;
      el.classList.remove('cp-btn-primary');
      el.classList.add('cp-btn-secondary');
    }
    function promote(el) {
      if (!el) return;
      el.classList.add('cp-btn-primary');
      el.classList.remove('cp-btn-secondary');
      var pill = el.querySelector('.cp-reco');
      if (pill) pill.hidden = false;
    }

    var macs = [document.getElementById('dl-mac'), document.getElementById('dl-mac-2')];
    var wins = [document.getElementById('dl-win'), document.getElementById('dl-win-2')];

    if (isWindows && !isMac) {
      wins.forEach(promote);
      macs.forEach(demote);
    } else if (isMac && !isWindows) {
      macs.forEach(promote);
      wins.forEach(demote);
    }
    /* unknown platform: leave both solid (default markup) */
  })();

  /* Progressive refresh: keep the displayed version/sizes current between
     deploys. Download hrefs already use the /latest/download redirect, so this
     only corrects text. Fails silently on any network/rate-limit error. */
  (function () {
    try {
      fetch('https://api.github.com/repos/DarkishLocket10/CullPix/releases/latest', {
        headers: { Accept: 'application/vnd.github+json' },
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d) return;
          if (d.tag_name) {
            document.querySelectorAll('[data-version]').forEach(function (el) {
              el.textContent = d.tag_name;
            });
          }
          if (d.published_at) {
            var ds = new Date(d.published_at).toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric',
            });
            document.querySelectorAll('[data-reldate]').forEach(function (el) {
              el.textContent = ds;
            });
          }
          var assets = d.assets || [];
          var dmg = assets.find(function (a) { return /\.dmg$/i.test(a.name); });
          var zip = assets.find(function (a) { return /\.zip$/i.test(a.name); });
          if (dmg) {
            var mb = Math.round(dmg.size / 1048576) + ' MB';
            document.querySelectorAll('#mac-size, .mac-size').forEach(function (el) { el.textContent = mb; });
          }
          if (zip) {
            var wb = Math.round(zip.size / 1048576) + ' MB';
            document.querySelectorAll('#win-size, .win-size').forEach(function (el) { el.textContent = wb; });
          }
        })
        .catch(function () {});
    } catch (e) {}
  })();
</script>
