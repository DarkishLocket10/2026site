---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScreenshotCompare from '../components/tools/ScreenshotCompare.astro';
import ExifStoryCard from '../components/tools/ExifStoryCard.astro';
---

<BaseLayout title="Yash | Tools" description="A collection of useful utilities">
  <section class="mx-auto max-w-7xl px-6 py-8">
    <!-- Page header -->
    <h1
      class="text-3xl font-extrabold mb-2
             opacity-0 -translate-y-6
             transition-all duration-700 ease-out
             motion-reduce:opacity-100 motion-reduce:translate-y-0"
      data-fade
    >
      Tools
    </h1>
    <p
      class="text-lg mb-8
             opacity-0 -translate-y-6
             transition-all duration-700 ease-out delay-100
             motion-reduce:opacity-100 motion-reduce:translate-y-0"
      style="color: var(--color-text-soft);"
      data-fade
    >
      A collection of utilities I've built for everyday workflows.
    </p>

    <!-- Tool selector -->
    <div
      class="flex flex-wrap gap-3 mb-8
             opacity-0 -translate-y-6
             transition-all duration-700 ease-out delay-200
             motion-reduce:opacity-100 motion-reduce:translate-y-0"
      data-fade
    >
      <button
        data-tool-btn="screenshot-compare"
        class="tool-card active"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="tool-card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        <div>
          <span class="tool-card-title">Screenshot Compare</span>
          <span class="tool-card-desc">Side-by-side old vs new comparison creator</span>
        </div>
      </button>

      <button
        data-tool-btn="exif-story-card"
        class="tool-card"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="tool-card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 15.75L17.25 4.929m0 0H9.75m7.5 0v7.5M6.75 19.5h10.5A1.5 1.5 0 0018.75 18V10.5m-12 9A1.5 1.5 0 015.25 18V7.5A1.5 1.5 0 016.75 6h6" />
        </svg>
        <div>
          <span class="tool-card-title">EXIF Story Card Builder</span>
          <span class="tool-card-desc">Turn a photo, its metadata, and its palette into a shareable card</span>
        </div>
      </button>

      <!-- Placeholder for future tools -->
      <div class="tool-card-placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" class="tool-card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="opacity:0.4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <div>
          <span class="tool-card-title" style="opacity:0.4">More coming soon</span>
          <span class="tool-card-desc" style="opacity:0.3">Stay tuned for new tools</span>
        </div>
      </div>
    </div>

    <!-- Tool content areas -->
    <div
      class="opacity-0 translate-y-6
             transition-all duration-700 ease-out delay-300
             motion-reduce:opacity-100 motion-reduce:translate-y-0"
      data-fade
    >
      <div data-tool-content="screenshot-compare">
        <ScreenshotCompare />
      </div>
      <div data-tool-content="exif-story-card" style="display:none">
        <ExifStoryCard />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ── Tool selector cards ── */
  .tool-card,
  .tool-card-placeholder {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: var(--radius-2xl);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--card-bg);
    color: var(--text);
    border: 2px solid transparent;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .tool-card-placeholder {
    cursor: default;
    box-shadow: none;
    border: 2px dashed rgba(0,0,0,0.1);
    background: transparent;
  }
  .dark .tool-card-placeholder {
    border-color: rgba(255,255,255,0.08);
  }

  .tool-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }

  .tool-card.active {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #fff;
  }

  .tool-card-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .tool-card-title {
    display: block;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .tool-card-desc {
    display: block;
    font-size: 12px;
    opacity: 0.7;
    line-height: 1.3;
  }

  .tool-card.active .tool-card-desc {
    opacity: 0.85;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var btns     = document.querySelectorAll('[data-tool-btn]');
    var contents = document.querySelectorAll('[data-tool-content]');

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tool = btn.getAttribute('data-tool-btn');

        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');

        contents.forEach(function (c) {
          c.style.display = c.getAttribute('data-tool-content') === tool ? '' : 'none';
        });
      });
    });
  });
</script>
