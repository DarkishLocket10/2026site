      ci.value = normalizeHex(ci.value);
      hi.value = ci.value;
      ci.addEventListener('input', function () { hi.value = ci.value.toLowerCase(); clearPaletteSelection(); renderCard(); });
      hi.addEventListener('change', function () { var n = normalizeHex(hi.value); hi.value = n; ci.value = n; clearPaletteSelection(); renderCard(); });
    }

    function hexToRgb(h) { var n = normalizeHex(h).slice(1); return { r: parseInt(n.slice(0,2),16), g: parseInt(n.slice(2,4),16), b: parseInt(n.slice(4,6),16) }; }
    function rgbToHex(c) { return '#' + [c.r,c.g,c.b].map(function(v){ return Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0'); }).join(''); }
    function withAlpha(h, a) { return normalizeHex(h) + Math.max(0,Math.min(255,Math.round(a*255))).toString(16).padStart(2,'0'); }
    function lum(h) { var c = hexToRgb(h); return (0.2126*c.r + 0.7152*c.g + 0.0722*c.b) / 255; }
    function contrast(h) { return lum(h) > 0.54 ? '#111111' : '#f3eadf'; }
    function colorDist(a, b) { var x = hexToRgb(a), y = hexToRgb(b); return Math.sqrt((x.r-y.r)**2 + (x.g-y.g)**2 + (x.b-y.b)**2); }
    function sat(h) { var c = hexToRgb(h); var mx = Math.max(c.r,c.g,c.b), mn = Math.min(c.r,c.g,c.b); return mx === 0 ? 0 : (mx-mn)/mx; }
    function mix(a, b, w) { var x = hexToRgb(a), y = hexToRgb(b); return rgbToHex({ r: x.r+(y.r-x.r)*w, g: x.g+(y.g-x.g)*w, b: x.b+(y.b-x.b)*w }); }

    function fmtExposure(v) { if (v==null||v==='') return ''; var n=Number(v); if (!isFinite(n)||n<=0) return String(v); return n>=1 ? n.toFixed(n%1===0?0:1)+'s' : '1/'+Math.round(1/n)+'s'; }
    function fmtAperture(v) { if (v==null||v==='') return ''; var n=Number(v); return isFinite(n) ? 'f/'+n.toFixed(n%1===0?0:1) : String(v); }
    function fmtFocal(v) { if (v==null||v==='') return ''; var n=Number(v); return isFinite(n) ? n.toFixed(n%1===0?0:1)+'mm' : String(v); }
    function fmtIso(v) { if (v==null||v==='') return ''; return /^iso/i.test(String(v)) ? String(v) : 'ISO '+v; }
    function fmtDate(v) { if (!v) return ''; var d = v instanceof Date ? v : new Date(v); return isNaN(d.getTime()) ? String(v) : d.toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}); }
    function cleanTitle(f) { return String(f||'').replace(/\.[^.]+$/,'').replace(/[-_]+/g,' ').trim().replace(/\b\w/g,function(m){return m.toUpperCase();}); }
    function fmtCoord(v,pos,neg) { return isFinite(v) ? Math.abs(v).toFixed(3)+' '+(v>=0?pos:neg) : ''; }

    function gpsText() {
      if (!state.gpsRaw || !isFinite(state.gpsRaw.latitude) || !isFinite(state.gpsRaw.longitude)) return '';
      return fmtCoord(state.gpsRaw.latitude,'N','S') + ', ' + fmtCoord(state.gpsRaw.longitude,'E','W');
    }

    function locationHeadline() {
      var m = String(locationInput.value||'').trim();
      if (m) return m;
      var g = gpsText();
      if (g) return g;
      return '';
    }

    function locationSubline() {
      var m = String(locationInput.value||'').trim();
      var g = gpsText();
      if (m && g) return g;
      return '';
    }

    function getLocationDisplay() {
      var m = String(locationInput.value||'').trim();
      var g = gpsText();
      if (m && g) return m + ' \u2022 ' + g;
      return m || g || '';
    }

    function getTags() {
      return String(tagsInput.value||'').split(/[,\u2022|]/).map(function(s){return s.trim();}).filter(Boolean);
    }

    function ts() { return Number(typeScaleInput.value) || 1; }
    function ds() { return Number(densityInput.value) || 1; }
    function sc(v) { return Math.round(v * ds()); }
    function pa() { return Number(photoAlignInput.value) || 0.5; }
    function palSz() { return Number(palSizeInput ? palSizeInput.value : 44); }
    function getKickerText(fallback) {
      if (showLabelInput && !showLabelInput.checked) return '';
      var v = layoutLabelInput ? layoutLabelInput.value.trim() : '';
      return v || fallback;
    }

    function getMetaItems() {
      return [
        { label: 'Camera', value: cameraInput.value.trim() },
        { label: 'Lens', value: lensInput.value.trim() },
        { label: 'Focal', value: focalInput.value.trim() },
        { label: 'Aperture', value: apertureInput.value.trim() },
        { label: 'Shutter', value: shutterInput.value.trim() },
        { label: 'ISO', value: isoInput.value.trim() },
        { label: 'Date', value: dateInput.value.trim() },
        { label: 'Location', value: showLocationInput.checked ? getLocationDisplay() : '' }
      ].filter(function (i) { return i.value; });
    }

    /* ── Dropzone ── */
    function setDropzone(filled) { dropzoneEmpty.style.display = filled ? 'none' : ''; dropzoneFilled.style.display = filled ? '' : 'none'; }
    function revokeUrl() { if (state.objectUrl) { URL.revokeObjectURL(state.objectUrl); state.objectUrl = ''; } }

    function loadImg(file) {
      return new Promise(function (res, rej) {
        var img = new Image();
        var url = URL.createObjectURL(file);
        img.onload = function () { res({ image: img, url: url }); };
        img.onerror = function () { URL.revokeObjectURL(url); rej(new Error('Load failed')); };
        img.src = url;
      });
    }

    async function handleFile(file) {
      if (!file || !file.type || file.type.indexOf('image/') !== 0) { setStatus('Upload an image file.'); return; }
      setStatus('Reading image\u2026');
      try {
        var loaded = await loadImg(file);
        revokeUrl();
        state.image = loaded.image;
        state.objectUrl = loaded.url;
        state.fileName = file.name;
        thumb.src = state.objectUrl;
        nameEl.textContent = file.name;
        setDropzone(true);
        await extractMeta(file);
        extractPalette();
        if (!titleInput.value.trim()) titleInput.value = cleanTitle(file.name);
        setStatus('');
        renderCard();
      } catch (e) { console.error(e); setStatus('Could not read that image.'); }
    }

    async function extractMeta(file) {
      try { state.exifRaw = await parseExif(file, ['Make','Model','LensModel','FocalLength','FNumber','ExposureTime','ISO','DateTimeOriginal','CreateDate']); } catch(e) { state.exifRaw = null; }
      try { state.gpsRaw = await parseGps(file); } catch(e) { state.gpsRaw = null; }
      fillFromExif();
    }

    function fillFromExif() {
      if (!state.exifRaw) { setStatus('No EXIF found.'); return; }
      var e = state.exifRaw;
      var cam = [e.Make||'', e.Model||''].filter(Boolean).join(' ').trim();
      if (cam) cameraInput.value = cam;
      if (e.LensModel) lensInput.value = e.LensModel;
      if (e.FocalLength != null) focalInput.value = fmtFocal(e.FocalLength);
      if (e.FNumber != null) apertureInput.value = fmtAperture(e.FNumber);
      if (e.ExposureTime != null) shutterInput.value = fmtExposure(e.ExposureTime);
      if (e.ISO != null) isoInput.value = fmtIso(e.ISO);
      if (e.DateTimeOriginal || e.CreateDate) dateInput.value = fmtDate(e.DateTimeOriginal || e.CreateDate);
      if (state.gpsRaw && !String(locationInput.value||'').trim()) locationInput.value = gpsText();
    }

    function extractPalette() {
      if (!state.image) return;

      // ── Step 1: downsample for speed ──────────────────────────────────────
      var sc2 = document.createElement('canvas'), sx2 = sc2.getContext('2d');
      if (!sx2) return;
      var iw = state.image.naturalWidth  || state.image.width;
      var ih = state.image.naturalHeight || state.image.height;
      var maxS = 128, s2 = Math.min(1, maxS / Math.max(iw, ih));
      var sw2 = Math.max(16, Math.round(iw * s2));
      var sh2 = Math.max(16, Math.round(ih * s2));
      sc2.width = sw2; sc2.height = sh2;
      sx2.drawImage(state.image, 0, 0, sw2, sh2);
      var d = sx2.getImageData(0, 0, sw2, sh2).data;

      // ── Step 2: quantize into buckets ─────────────────────────────────────
      // extractPrecInput: 8=fine, 32=broad (smaller bucket = more distinct colors captured)
      var bucket = Number(extractPrecInput ? extractPrecInput.value : 20);
      var bk = new Map();
      for (var i = 0; i < d.length; i += 4) {
        if (d[i+3] < 160) continue; // skip near-transparent
        var key2 = rgbToHex({
          r: Math.round(d[i]   / bucket) * bucket,
          g: Math.round(d[i+1] / bucket) * bucket,
          b: Math.round(d[i+2] / bucket) * bucket
        });
        bk.set(key2, (bk.get(key2) || 0) + 1);
      }

      // ── Step 3: sort by frequency, enforce perceptual diversity ───────────
      var sorted2 = Array.from(bk.entries())
        .sort(function(a, b) { return b[1] - a[1]; })
        .map(function(e) { return e[0]; });
      var minDist = Number(extractSpreadInput ? extractSpreadInput.value : 40);
      var pool = [];
      sorted2.forEach(function(h2) {
        if (pool.length < 12 && pool.every(function(e) { return colorDist(e, h2) > minDist; }))
          pool.push(h2);
      });
      if (!pool.length) pool = ['#6d7280','#c98b45','#71717a','#1f2937','#f3eadf'];

      // ── Step 4: assign roles with perceptual logic ────────────────────────
      // Dominant  — most frequent color
      var dominant2 = pool[0];

      // Accent — most saturated with sat > threshold; prefer visually different from dominant
      var accentCands = pool.slice().sort(function(a, b) { return sat(b) - sat(a); });
      var accent2 = accentCands.find(function(c) { return sat(c) > 0.18; }) || accentCands[0] || dominant2;

      // Muted — low saturation, mid-luminance (avoid very dark/very light near-grays)
      var mutedCands = pool.slice()
        .filter(function(c) { var l = lum(c); return l > 0.06 && l < 0.75; })
        .sort(function(a, b) { return sat(a) - sat(b); });
      var muted2 = mutedCands[0] || mix(dominant2, '#808080', 0.5);

      // Shadow — darkest in pool; prefer distinctly dark (lum < 0.25)
      var shadow2 = pool.slice().sort(function(a, b) { return lum(a) - lum(b); })[0] || '#111111';

      // Highlight — lightest in pool; prefer distinctly light (lum > 0.6)
      var highlight2 = pool.slice().sort(function(a, b) { return lum(b) - lum(a); })[0] || '#f3eadf';

      // If shadow and highlight are too close, derive from dominant
      if (colorDist(shadow2, highlight2) < 40) {
        shadow2    = mix(dominant2, '#000000', 0.7);
        highlight2 = mix(dominant2, '#ffffff', 0.7);
      }

      state.palette = {
        dominant:  dominant2,
        accent:    accent2,
        muted:     muted2,
        shadow:    shadow2,
        highlight: highlight2
      };
      updateSwatches();
    }

    function updateSwatches() {
      Array.from(paletteGrid.querySelectorAll('[data-role]')).forEach(function(btn){
        var role = btn.getAttribute('data-role');
        var c = state.palette[role] || '#888';
        btn.style.background = c;
        btn.style.color = contrast(c);
        btn.textContent = role.charAt(0).toUpperCase()+role.slice(1)+'\n'+c;
      });
    }

    function applyPalette() {
      var bg = lum(state.palette.shadow) < 0.34 ? state.palette.shadow : mix(state.palette.dominant, '#111111', 0.55);
      var tx = contrast(bg);
      bgInput.value = normalizeHex(bg); bgHex.value = bgInput.value;
      textInput.value = normalizeHex(tx); textHex.value = textInput.value;
      accentInput.value = normalizeHex(state.palette.accent); accentHex.value = accentInput.value;
      mutedInput.value = normalizeHex(state.palette.muted); mutedHex.value = mutedInput.value;
      borderInput.value = normalizeHex(mix(bg, tx, 0.2)); borderHex.value = borderInput.value;
      resetFontColors();
      renderCard();
    }

    /* ── Palette presets ── */
    var PALETTE_PRESETS = {
      'street-noir':      { bg:'#0A0A0A', text:'#E8E4DF', accent:'#D4281C', muted:'#3A3A3A', border:'#1F1F1F' },
      'street-riso':      { bg:'#F5F0E0', text:'#1A1612', accent:'#E63946', muted:'#B8AE9E', border:'#D4CDB8' },
