---
interface Crumb {
  label: string;
  href?: string;
}
const { items } = Astro.props as { items: Crumb[] };
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>
        {c.href && i < items.length - 1 ? (
          <a href={c.href}>{c.label}</a>
        ) : (
          <span aria-current={i === items.length - 1 ? 'page' : undefined}>{c.label}</span>
        )}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs {
    font-family: var(--font-sans);
    font-size: .82rem;
    margin: .25rem 0 1.25rem;
    color: var(--color-text-soft);
  }
  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem .5rem;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin: 0;
  }
  .crumbs a {
    color: var(--color-text-soft);
    text-decoration: none;
    transition: color .2s var(--ease-spring);
  }
  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--color-accent);
  }
  .crumbs [aria-current="page"] {
    color: var(--text);
    font-weight: 500;
  }
  .sep {
    opacity: .45;
    user-select: none;
  }
</style>
