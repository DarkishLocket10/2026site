      'journal-weathered':{ bg:'#D8C8A8', text:'#3A2E20', accent:'#7A4422', muted:'#BCA880', border:'#C4B08C' },
      'journal-expedition':{ bg:'#1E1810', text:'#D4C4A0', accent:'#C8842A', muted:'#3A3020', border:'#2C2418' },
      'edit-aperture':    { bg:'#FAF8F4', text:'#1C1C1C', accent:'#C41E3A', muted:'#7A7670', border:'#E8E4DE' },
      'edit-natgeo':      { bg:'#FEFCF6', text:'#1A1A1A', accent:'#FFCC00', muted:'#6B6860', border:'#E0DCD4' },
      'edit-noir':        { bg:'#141414', text:'#F0ECE4', accent:'#D4A04A', muted:'#4A4844', border:'#242220' }
    };

    function resetFontColors() {
      var label = normalizeHex(accentInput.value);
      var title = normalizeHex(textInput.value);
      var body  = normalizeHex(mix(textInput.value, bgInput.value, 0.18));
      var meta  = normalizeHex(mix(textInput.value, bgInput.value, 0.30));
      if (colorLabelInput) { colorLabelInput.value = label; colorLabelHex.value = label; }
      if (colorTitleInput) { colorTitleInput.value = title; colorTitleHex.value = title; }
      if (colorBodyInput)  { colorBodyInput.value  = body;  colorBodyHex.value  = body; }
      if (colorMetaInput)  { colorMetaInput.value  = meta;  colorMetaHex.value  = meta; }
    }

    function applyPalettePreset(key) {
      var p = PALETTE_PRESETS[key];
      if (!p) return;
      bgInput.value = p.bg; bgHex.value = p.bg;
      textInput.value = p.text; textHex.value = p.text;
      accentInput.value = p.accent; accentHex.value = p.accent;
      mutedInput.value = p.muted; mutedHex.value = p.muted;
      borderInput.value = p.border; borderHex.value = p.border;
      resetFontColors();
      renderCard();
    }

    /* ── Palette preset picker helpers ── */
    var PP_GROUPS = [
      { label: 'Street Notes',   keys: ['street-noir','street-riso','street-neon'] },
      { label: 'Postcard',       keys: ['post-kodachrome','post-seaside','post-airmail'] },
      { label: 'Lens Ledger',    keys: ['ledger-lcd','ledger-blueprint','ledger-scope'] },
      { label: 'Gallery Plaque', keys: ['gallery-white','gallery-dark','gallery-concrete'] },
      { label: 'Contact Sheet',  keys: ['contact-darkroom','contact-proof','contact-ilford'] },
      { label: 'Transit Pass',   keys: ['transit-boarding','transit-jr','transit-metro'] },
      { label: 'Field Journal',  keys: ['journal-kraft','journal-weathered','journal-expedition'] },
      { label: 'Editorial',      keys: ['edit-aperture','edit-natgeo','edit-noir'] }
    ];
    var PP_NAMES = {
      'street-noir':'Moriyama Noir','street-riso':'Risograph Zine','street-neon':'Shinjuku Night',
      'post-kodachrome':'Kodachrome','post-seaside':'Seaside Chrome','post-airmail':'Airmail',
      'ledger-lcd':'LCD Readout','ledger-blueprint':'Blueprint','ledger-scope':'Oscilloscope',
