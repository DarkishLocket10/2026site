---
// Curated physical shelves; shared interactions live in bookshelf/interactions.ts.
import topMusicData  from '../data/top-music.json';
import topMoviesData from '../data/top-movies.json';
import topGamesData  from '../data/top-games.json';
import type { CaseKind, CdDisc } from '../lib/cdcase/types';
import { imageSize } from '../lib/homepage-images';

type ShelfItem = {
  rank: number;
  title: string;
  creator: string;
  sub: string;
  url: string;
  image: string | null;
  accent: string;
  logo?: string | null;
  icon?: string | null;
  logoScale?: number | null;
  crop?: string | null;
};

type Shelf = {
  id: 'music' | 'film' | 'games';
  label: string;
  empty: string;
  items: ShelfItem[];
};

// Artwork manifests are optional at build time; absent files/fields retain the
// curated shelf images. CD manifests also support their older title-creator keys.
type Artwork = {
  title?: string; creator?: string; front?: string | null; back?: string | null;
  disc?: string | null; spine?: string | null; bookletInside?: string | null;
  inside?: string | null; hasBanner?: boolean; official?: boolean;
  finish?: CdDisc['finish']; discType?: CdDisc['discType']; relief?: string | null;
};
type ArtManifest = { items?: Record<string, Artwork> };
const artModules = import.meta.glob<ArtManifest>('../data/*-art.json', { eager: true, import: 'default' });
const manifest = (name: string) => artModules[`../data/${name}-art.json`]?.items ?? {};
const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const musicItems: ShelfItem[] = topMusicData.items.slice(0, 10);
const movieItems: ShelfItem[] = topMoviesData.items.slice(0, 10);
const gameItems: ShelfItem[] = topGamesData.items.slice(0, 10);
const hiRes = (url: string | null) => url ? url.replace(/\/i\/u\/\d+x\d+\//, '/i/u/770x0/') : null;
const caseKinds: Record<Shelf['id'], CaseKind> = { music: 'jewel', film: 'bluray', games: 'steelbook' };
function caseItems(items: ShelfItem[], name: string): CdDisc[] {
  const entries = manifest(name);
  return items.map(item => {
    const art = entries[slug(item.title)] ?? entries[slug(`${item.title}-${item.creator}`)]
      ?? Object.values(entries).find(entry => entry.title === item.title && (!entry.creator || entry.creator === item.creator));
    const fallback = name === 'cd' ? hiRes(item.image) : item.image;
    return {
      id: slug(`${item.title}-${item.creator}`), name: `${item.title} — ${item.creator}`,
      art: art?.disc ?? art?.front ?? fallback, cover: art?.front ?? fallback,
      fallback, discIsScan: !!art?.disc, back: art?.back ?? null,
      bookletInside: art?.bookletInside ?? null, inside: art?.inside ?? null,
      spine: art?.spine ?? null, hasBanner: art?.hasBanner ?? false,
      finish: art?.finish ?? 'matte', relief: art?.relief ?? null,
      discType: art?.discType ?? (name === 'cd' ? 'cd' : 'bluray'),
      accent: item.accent, spineColour: item.accent,
      spineLogo: item.logo ?? undefined, label: item.title, base: 'print',
    };
  });
}
const cases: Record<Shelf['id'], CdDisc[]> = {
  music: caseItems(musicItems, 'cd'), film: caseItems(movieItems, 'bluray'), games: caseItems(gameItems, 'steelbook'),
};
const shelves: Shelf[] = [
  { id: 'music', label: 'Music', empty: 'No albums yet.', items: musicItems },
  { id: 'film', label: 'Film', empty: 'Add your top films in top-movies.json.', items: movieItems },
  { id: 'games', label: 'Games', empty: 'Add your top games in top-games.json.', items: gameItems },
];
---

<section id="bookshelves" class="w-full py-6" aria-label="My favourite music, films, and games">
  <div class="bookshelves-root mx-auto w-full px-6">
    <div class="shelves-grid">
      {shelves.map((shelf) => (
        <section class="shelf-col" data-kind={shelf.id} aria-labelledby={`shelf-${shelf.id}-label`}>
          <div class="shelf-head">
            <h2 class="shelf-label" id={`shelf-${shelf.id}-label`}>{shelf.label}</h2>
            <span class="shelf-count">{shelf.items.length} favourites</span>
          </div>
          {shelf.items.length === 0 ? (
            <div class="shelf-empty">{shelf.empty}</div>
          ) : (
            <>
              <p class="shelf-hint" data-browse-label>Choose a spine to pull it out.</p>
              <p class="shelf-sr-only" id={`shelf-${shelf.id}-keys`}>
                Left and Right move between spines. Home and End move to the first and last.
                Enter selects and focuses the case. Space selects. Escape returns to the selected spine.
              </p>
              <div class="shelf-scene">
                <div class="shelf-inner">
                  <ol class="shelf-items" role="list" aria-label={`${shelf.label} top ten`}>
                    {shelf.items.map((it, i) => (
                      <li class="spine-slot" style={`--accent: ${it.accent};`}>
                        <button type="button" class="spine" data-spine data-idx={i}
                          data-title={it.title} data-creator={it.creator} data-sub={it.sub}
                          data-rank={it.rank} data-image={it.image ?? ''} data-accent={it.accent}
                          data-logo={it.logo ?? ''} data-crop={it.crop ?? ''} data-url={it.url}
                          data-active={i === 0 ? 'true' : undefined}
                          tabindex={i === 0 ? 0 : -1} aria-pressed={i === 0}
                          aria-controls={`shelf-${shelf.id}-case`}
                          aria-describedby={`shelf-${shelf.id}-keys`}
                          aria-label={`#${it.rank}: ${it.title} — ${it.creator}. Pull out case.`}
                          style={it.logoScale != null ? `--logo-scale: ${it.logoScale};` : undefined}>
                          <span class="spine-body" aria-hidden="true">
                            {it.logo && <img class="spine-logo" src={it.logo} alt="" loading="lazy" decoding="async" {...imageSize(it.logo)} />}
                            {shelf.id === 'games' && it.icon && (
                              <img class="spine-icon" src={it.icon} alt="" loading="lazy" decoding="async" {...imageSize(it.icon)} />
                            )}
                            <span class="spine-text">{it.title}</span>
                            <span class="spine-top"></span>
                            <span class="spine-gutter spine-gutter--l"></span>
                            <span class="spine-gutter spine-gutter--r"></span>
                            <span class="spine-shine"></span>
                          </span>
                        </button>
                      </li>
                    ))}
                  </ol>
                  <div class="shelf-board" aria-hidden="true"></div>
                </div>
                <div class="case-viewer" id={`shelf-${shelf.id}-case`}>
                  <div class="shelf-cover-panel" data-cover-panel>
                    <div class="cd3d" data-cd3d data-case-kind={caseKinds[shelf.id]}
                      data-discs={JSON.stringify(cases[shelf.id])} aria-hidden="true"></div>
                    <button class="cd3d-hit" data-cd3d-hit type="button" tabindex="-1" aria-hidden="true"
                      aria-describedby={`shelf-${shelf.id}-case-help`}
                      aria-label={`${shelf.label} case: ${shelf.items[0].title}. Enter to open or close.`}></button>
                    <a
                      class="cover-case cover-link"
                      data-cover-case
                      data-cover-link
                      href={shelf.items[0].url || '#'}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Details for ${shelf.items[0].title} (opens in a new tab)`}
                      style={shelf.id === 'music'
                        ? `--spine-color: ${shelf.items[0].accent || '#2a2a2a'}`
                        : undefined}
                    >

                      <span class="cover-shine" aria-hidden="true"></span>

                      <img
                        class="cover-image"
                        data-cover-image
                        src={shelf.items[0].image || undefined}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        {...imageSize(shelf.items[0].image, shelf.id === 'music' ? 900 : 600, 900)}
                        style={shelf.items[0].crop
                          ? `object-position: ${shelf.items[0].crop}`
                          : undefined}
                      />

                      {shelf.id === 'music' && (
                        <img
                          class="cover-spine-logo"
                          data-cover-spine-logo
                          src={shelf.items[0].logo || undefined}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          {...imageSize(shelf.items[0].logo)}
                          aria-hidden="true"
                        />
                      )}

                      <div class="cover-fallback" data-cover-fallback hidden={!!shelf.items[0].image}>
                        <span class="cover-band cover-band--top" aria-hidden="true"></span>
                        <span class="cover-body">
                          <span class="cover-title" data-cover-title>{shelf.items[0].title}</span>
                          <span class="cover-creator" data-cover-creator>{shelf.items[0].creator}</span>
                        </span>
                        <span class="cover-band cover-band--bottom">
                          <span class="cover-meta" data-cover-meta>{shelf.items[0].sub}</span>
                        </span>
                      </div>
                    </a>
                  </div>
                  <div class="case-controls" role="group" aria-label={`${shelf.label} case navigation`}>
                    <button class="case-step" data-case-prev type="button" aria-label={`Previous ${shelf.label.toLowerCase()} item`}
                      aria-controls={`shelf-${shelf.id}-case`}><span aria-hidden="true">←</span></button>
                    <span class="case-counter" data-case-counter aria-label={`Item 1 of ${shelf.items.length}`}>1 / {shelf.items.length}</span>
                    <button class="case-step" data-case-next type="button" aria-label={`Next ${shelf.label.toLowerCase()} item`}
                      aria-controls={`shelf-${shelf.id}-case`}><span aria-hidden="true">→</span></button>
                  </div>
                  <p class="case-help" id={`shelf-${shelf.id}-case-help`}>
                    <span data-case-help>Choose a spine or use the arrows.</span>
                    <span class="shelf-sr-only">When the interactive case is ready, Enter opens or closes it;
                      Left and Right change items. Escape returns to the shelf.</span>
                  </p>
                </div>
              </div>
              <div class="shelf-info" data-info>
                <div class="info-announcement" role="status" aria-live="polite" aria-atomic="true" data-info-content>
                  <span class="info-rank" data-info-rank>#{shelf.items[0].rank}</span>
                  <div class="info-text">
                    <div class="info-title" data-info-title>{shelf.items[0].title}</div>
                    <div class="info-sub">
                      <span data-info-creator>{shelf.items[0].creator}</span>
                      <span class="info-sep" data-info-sep hidden={!shelf.items[0].sub}>·</span>
                      <span data-info-sub>{shelf.items[0].sub}</span>
                    </div>
                    <span class="info-face" data-info-face hidden></span>
                  </div>
                </div>
                <a class="case-external" data-case-url href={shelf.items[0].url}
                  target="_blank" rel="noopener noreferrer">
                  {shelf.id === 'music' ? 'Last.fm' : shelf.id === 'film' ? 'Film details' : 'Game details'}
                  <span aria-hidden="true">↗</span><span class="shelf-sr-only"> (opens in a new tab)</span>
                </a>
              </div>
            </>
          )}
        </section>
      ))}
    </div>
  </div>
</section>

<style>

  #bookshelves { overflow-x: clip; }
  [hidden] { display: none !important; }
  .bookshelves-root { max-width: 1200px; }
  .shelves-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3.5rem; }
  .shelf-col {
    --cd: 260px;
    --spine-width: 24px;
    min-width: 0;
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
  }
  [data-kind="music"] { --spine-width: 16px; }
  .shelf-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .shelf-label { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .shelf-count { font-size: 11px; opacity: .65; font-variant-numeric: tabular-nums; }
  .shelf-hint { margin: .5rem 0 0; min-height: 2.8em; font-size: 12px; line-height: 1.4; opacity: .72; }
  .shelf-scene {
    display: grid;
    grid-template-columns: 256px minmax(0, 1fr);
    column-gap: 22px;
    align-items: start;
    padding-top: 34px;
    perspective: 1400px;
    perspective-origin: 50% 8%;
  }
  .shelf-inner {
    margin-top: 20px;
    transform-style: preserve-3d;
    transform: rotateX(7deg);
    transform-origin: 50% 100%;
  }
  .shelf-items {
    display: flex;
    align-items: flex-end;
    height: 220px;
    padding: 0 8px;
    margin: 0;
    list-style: none;
    transform-style: preserve-3d;
  }
  .spine-slot { position: relative; flex: 0 0 24px; height: 220px; transform-style: preserve-3d; }
  .spine-slot::before {
    content: "";
    position: absolute;
    inset: 1px calc((24px - var(--spine-width)) / 2) 0;
    background: linear-gradient(90deg, #17120e, #31251c 60%, #17120e);
    box-shadow: inset 0 0 6px #0009;
    border-radius: 2px 2px 0 0;
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .spine-slot:has([data-active="true"])::before { opacity: .8; }
  .spine-slot:has(:focus-visible), .spine-slot:has([data-active="true"]) { z-index: 2; }
  .spine {
    position: relative;
    display: grid;
    place-items: center;
    width: 24px;
    height: 220px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
    transform-style: preserve-3d;
  }
  .spine-body {
    position: relative;
    display: block;
    width: var(--spine-width);
    height: 220px;
    pointer-events: none;
    transform-origin: 50% 100%;
    transform: rotateZ(var(--lean, 0deg));
    transition: transform 300ms cubic-bezier(.2,.7,.2,1), filter 240ms ease;
  }
  .spine-slot:nth-child(3n) { --lean: .6deg; }
  .spine-slot:nth-child(5n+2) { --lean: -.5deg; }
  .spine:focus-visible .spine-body {
    transform: translateY(-7px) translateZ(12px) rotateX(-5deg);
    filter: brightness(1.12) drop-shadow(3px 5px 4px #0004);
  }
  @media (hover: hover) {
    .spine-slot:hover { z-index: 3; }
    .spine:hover .spine-body {
      transform: translateY(-7px) translateZ(12px) rotateX(-5deg);
      filter: brightness(1.12) drop-shadow(3px 5px 4px #0004);
    }
  }
  .spine[data-active="true"] .spine-body {
    transform: translateY(-17px) translateZ(22px) rotateX(-9deg);
    filter: brightness(1.18) drop-shadow(4px 8px 5px #0005);
  }
  .spine:focus-visible, .case-step:focus-visible, .case-external:focus-visible,
  .cover-link:focus-visible, .cd3d-hit:focus-visible {
    outline: 2px solid var(--color-accent, #a86112);
    outline-offset: 4px;
    border-radius: 3px;
  }
  .spine-text {
    position: absolute; inset: 7px 0; writing-mode: vertical-rl; transform: rotate(180deg);
    text-align: right; font-size: 9.5px; font-weight: 700; letter-spacing: .04em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 1px; line-height: 1;
  }
  .spine-top { position: absolute; top: 0; left: 0; right: 0; height: 2px;
    border-radius: inherit; background: linear-gradient(180deg, #ffffff59, transparent); }
  .spine-gutter { position: absolute; top: 0; bottom: 0; width: 1px; }
  .spine-gutter--l { left: 0; background: #00000047; }
  .spine-gutter--r { right: 0; background: #00000038; }
  .spine-shine { position: absolute; top: 0; bottom: 0; left: 35%; width: 1px; opacity: .6;
    background: linear-gradient(180deg, transparent, #ffffff59 18%, #ffffff1f 60%, transparent); }
  .shelf-board {
    position: relative;
    height: 13px;
    margin: 0 -4px;
    border-radius: 2px;
    background: linear-gradient(180deg, #6b4a2b, #4a3120 45%, #2f1e11);
    box-shadow: inset 0 1px 0 #ffffff1f, inset 0 -1px 0 #00000059, 0 6px 14px -4px #0009, 0 18px 28px -12px #0007;
  }
  :global(.dark) .shelf-board { background: linear-gradient(180deg, #3d2a1a, #2a1b10 45%, #1a110a); }
  .case-viewer { display: flex; flex-direction: column; align-items: center; min-width: 0; }
  .shelf-cover-panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--cd);
    height: var(--cd);
    max-width: 100%;
    perspective: 700px;
    touch-action: pan-y;
  }
  .cover-link { color: inherit; text-decoration: none; cursor: pointer; }
  .cd3d {
    position: absolute;
    left: 50%; top: 50%;
    width: calc(var(--cd) * 2);
    height: calc(var(--cd) * 1.42);
    transform: translate(-50%, -50%);
    visibility: hidden;
    pointer-events: none;
  }
  [data-kind="film"] .shelf-cover-panel, [data-kind="games"] .shelf-cover-panel { width: calc(var(--cd) * .79); }
  [data-kind="film"] .cd3d, [data-kind="games"] .cd3d { width: calc(var(--cd) * 1.58); height: calc(var(--cd) / .7); }
  .cd3d-hit {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    padding: 0; border: 0; background: transparent; color: inherit;
    /* Vertical gestures scroll the page, horizontal gestures stay with the case. */
    touch-action: pan-y !important;
  }
  [data-kind="music"] .cd3d-hit { top: 6%; bottom: 6%; }
  [data-cd3d-ready] .cd3d { visibility: visible; }
  [data-cd3d-ready] .cd3d-hit { pointer-events: auto; }
  .case-controls { display: flex; align-items: center; gap: 8px; margin-top: 34px; position: relative; z-index: 2; }
  .case-step {
    display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border-radius: 50%;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    background: color-mix(in srgb, var(--bg, #ddd) 85%, transparent);
    color: inherit; cursor: pointer; font-size: 18px; touch-action: manipulation;
    transition: background-color 150ms ease, transform 150ms ease;
  }
  .case-step:hover { background: color-mix(in srgb, currentColor 10%, var(--bg, #ddd)); }
  .case-step:active { transform: scale(.94); }
  .case-counter { min-width: 44px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; opacity: .8; }
  .case-help { margin: 8px 0 16px; min-height: 2.8em; text-align: center; font-size: 11px; line-height: 1.4; opacity: .7; max-width: 240px; }
  .shelf-info {
    display: flex; align-items: start; justify-content: space-between; gap: 16px; padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  }
  .info-announcement { display: flex; align-items: start; gap: 10px; min-width: 0; flex: 1; }
  .info-rank { font-size: 11px; line-height: 22px; min-width: 30px; text-align: center; font-variant-numeric: tabular-nums;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: 4px; }
  .info-text { min-width: 0; min-height: 64px; }
  .info-title { font-size: 14px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; text-wrap: pretty; }
  .info-sub { margin-top: 3px; font-size: 12px; line-height: 1.5; opacity: .72; overflow-wrap: anywhere; }
  .info-sep { margin: 0 .3rem; }
  .info-face { display: block; margin-top: 5px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  .case-external { display: inline-flex; gap: 5px; align-items: center; flex-shrink: 0; min-height: 28px;
    font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  .shelf-empty { padding: 1rem 0; font-size: 12px; }
  .shelf-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (min-width: 1600px) {
    .bookshelves-root { max-width: 1680px; }
    .shelves-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .shelf-col { --cd: 220px; }
    .shelf-scene { column-gap: 16px; }
    .shelf-inner { margin-top: 0; }
    .shelf-info { flex-wrap: wrap; gap: 4px; }
    .info-announcement { flex-basis: 100%; }
    .case-external { margin-left: 42px; }
  }
  @media (max-width: 620px) {
    .shelf-col { --cd: min(68vw, 260px); }
    .shelf-scene { grid-template-columns: minmax(0, 1fr); row-gap: 54px; padding-top: 22px; }
    .shelf-inner { width: 256px; max-width: 100%; margin: 0 auto; }
    .cd3d { max-width: calc(100vw - 12px); }
    .shelf-info { flex-wrap: wrap; gap: 4px; }
    .info-announcement { flex-basis: 100%; }
    .case-external { margin-left: 42px; }
  }
  .cover-case {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    overflow: hidden;
    box-shadow:
      0 14px 22px -8px rgba(0, 0, 0, 0.55),
      0 5px 10px -3px rgba(0, 0, 0, 0.42);
    transform-origin: 50% 100%;
    transform-style: preserve-3d;

    animation: ps2-float-case 5.7s cubic-bezier(.45, 0, .55, 1) infinite;
    will-change: auto;
  }

  [data-kind="music"] .cover-case { animation-delay: 0s; }
  [data-kind="film"]  .cover-case { animation-delay: -1.9s; animation-duration: 6.3s; }

  [data-kind="games"] .cover-case {
    animation-name: ps2-float-case-games;
    animation-delay: -3.4s;
    animation-duration: 5.1s;
    box-shadow: none;
  }

  @keyframes ps2-float-case {
    0%   { transform: rotateY(-3deg) rotateX(1deg)  translateY(0);
           box-shadow: 0 8px 14px -6px rgba(0,0,0,.6),
                       0 3px 6px -2px rgba(0,0,0,.4); }
    25%  { transform: rotateY(-1deg) rotateX(-1deg) translateY(-2px);
           box-shadow: 0 12px 18px -6px rgba(0,0,0,.55),
                       0 5px 10px -3px rgba(0,0,0,.38); }
    50%  { transform: rotateY(2deg)  rotateX(1.5deg) translateY(-3px);
           box-shadow: 0 16px 24px -6px rgba(0,0,0,.5),
                       0 7px 14px -3px rgba(0,0,0,.36); }
    75%  { transform: rotateY(1deg)  rotateX(-0.5deg) translateY(-1px);
           box-shadow: 0 10px 16px -6px rgba(0,0,0,.55),
                       0 4px 8px -3px rgba(0,0,0,.4); }
    100% { transform: rotateY(-3deg) rotateX(1deg)  translateY(0);
           box-shadow: 0 8px 14px -6px rgba(0,0,0,.6),
                       0 3px 6px -2px rgba(0,0,0,.4); }
  }

  @keyframes ps2-float-case-games {
    0%   { transform: rotateY(-3deg) rotateX(1deg)  translateY(0); }
    25%  { transform: rotateY(-1deg) rotateX(-1deg) translateY(-2px); }
    50%  { transform: rotateY(2deg)  rotateX(1.5deg) translateY(-3px); }
