---
import Layout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Education from '../components/Education.astro';
import ProfessionalExperience from "../components/ProfessionalExperience.astro";
import Work from "../components/Work.astro";
import Photography from "../components/Photography.astro";
import Gallery from "../components/gallery.astro";
import BlogDisplay from '../components/BlogDisplay.astro';

const educationItems = [
  {
    years: '2020–2025',
    institution: "Queen's University",
    details: 'Bachelor of Computing (Honours), Specialization in Software Design',
  },
  {
    years: '2016–2020',
    institution: 'Korah Collegiate & Vocational School',
    details: 'High School Diploma, Academic Stream',
  },
];

const workItems = [
  {
    imageSrc: '/mainphotos/bruce.png',
    link: 'https://www.brucepower.com',
    altText: 'Bruce Power',
    label: `☑️ Led full‑stack development (PHP, JavaScript, SQL) to completely overhaul the supplier scorecard platform

☑️ Utilized Agile methodology to rapidly respond to client needs and consistently deliver on or ahead of schedule

☑️ Automated reporting, slashing monthly scorecard prep time by 40% and boosting data accuracy

☑️ Managed Tier 1 & Tier 2 supplier assessments across safety, quality, cost, capacity & schedule  

☑️ Built ML‑driven automations to predict financial/operational outcomes and supercharge supply‑chain efficiency
    `,
  },
  {
  imageSrc:   '/mainphotos/blog.jpg',
    link:        '/blog',
    altText:     'Personal Blog',
    label: `☑️ Curated mix of personal essays, tutorials & reflections on identity, coding, and photography

☑️ Powered by Astro with MDX for flexible, markdown‑driven posts

☑️ Auto‑imports all markdown files with Vite for a zero‑config setup

☑️ Sleek card UI built with TailwindCSS: thumbnails, excerpts, dates & tags

☑️ Optimized images, dark/light themes, and tag‑based filtering for smooth browsing`,
  },
  {
  imageSrc:   '/mainphotos/triage.png',
    link:        'https://github.com/DarkishLocket10/phototriage_cpp',
    altText:     'Photo Triage',
    label:      `☑️ Developed a C++ tool to automate photo organization, speeding up the triage process for large datasets
    
☑️ Incredibly lightweight (it's portable!) and fast with a focus on performance and efficiency

☑️ User friendly interface for easy operation

☑️ Open source and available on GitHub

☑️ Built with C++ and Qt for cross-platform compatibility

☑️ Supports various image formats including JPEG, PNG, and RAW`,
  },
];

---



<Layout title="Yash | Portfolio" description="Welcome to my site">
  <Hero
    title="Hey, I'm Yash!"
    subtitle="Welcome to my website."
    description="I'm a computer scientist from Sault Ste. Marie, Ontario, with a Bachelor of Computing Honours from <a href='https://www.queensu.ca/' target=_blank class='underline hover:opacity-80'>Queen's University</a>. My experience covers software design, AI and machine learning, cyber security, and data analytics. I enjoy solving challenging puzzles, creating innovative software solutions, and exploring <a href='https://piwigo.darkishlocket10.me' target=_blank class='underline hover:opacity-80'>photography</a> in my spare time. Please feel free to explore my portfolio and <a href='mailto:yashnilay@gmail.com' target=_blank class='underline hover:opacity-80'>reach out</a> if you'd like to collaborate!"
    image="/mainphotos/about.jpg"
    alt="Photo of Yash Patel"
  />

  <Education items={educationItems} />


  <ProfessionalExperience
    title="Professional Experience"
    subtitle="A brief overview of my work history"
    description="With extensive experience in full-stack development, data analysis, and automation, I create and optimize digital solutions to streamline business operations and enhance user experiences."
    image="/mainphotos/Professional.jpg"
    alt="Yash taking a photo"
  />

<Work items={workItems} title="Projects & Experience" />

<BlogDisplay />




  <Photography
    title="Did I mention that I take photos?"
    subtitle=""
    description="Over five years (and counting) behind the lens!"
    image="/mainphotos/pro2.jpg"
    alt="Yash standing in the middle of a city street"
  />

  <div class="mt-12">
    <Gallery />
  </div>
  
  
</Layout>
