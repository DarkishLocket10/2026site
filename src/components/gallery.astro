  .gallery-fx-row-icon svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .gallery-fx-row-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1 1 auto;
  }
  .gallery-fx-row-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
  }
  .gallery-fx-row-help {
    font-size: 11px;
    color: var(--color-text-soft);
    line-height: 1.35;
  }

  /* ── Switch ─────────────────────────────────────────────────────────
     Cyan accent (--color-accent) when on, neutral grey when off.
     Solid colors only, no gradients.
  */
  .gallery-fx-switch {
    position: relative;
    flex: 0 0 auto;
    width: 42px;
    height: 24px;
  }
  .gallery-fx-switch input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
  }
  .gallery-fx-switch-track {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.18);
    border-radius: var(--radius-pill);
    transition: background 220ms var(--ease-out);
    pointer-events: none;
  }
  :root.dark .gallery-fx-switch-track {
    background: rgba(255, 255, 255, 0.18);
  }
  .gallery-fx-switch-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: #ffffff;
    border-radius: var(--radius-pill);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    transition: transform 220ms var(--ease-spring);
    pointer-events: none;
  }
  .gallery-fx-switch input:checked ~ .gallery-fx-switch-track {
    background: var(--color-accent);
  }
  .gallery-fx-switch input:checked ~ .gallery-fx-switch-thumb {
    transform: translateX(18px);
  }
  .gallery-fx-switch input:focus-visible ~ .gallery-fx-switch-track {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Footer ─────────────────────────────────────────────────────────
     Mirrors the page's ghost-button pattern: hairline border + transparent
     fill, accent color tint on hover.
  */
  .gallery-fx-footer {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    justify-content: flex-end;
  }
  :root.dark .gallery-fx-footer {
    border-top-color: rgba(255, 255, 255, 0.08);
  }
  .gallery-fx-reset {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 5px 10px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--color-text-soft);
    cursor: pointer;
    border-radius: var(--radius-lg);
    transition:
      color 160ms var(--ease-out),
      background 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
